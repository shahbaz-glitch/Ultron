
<rml>
<head>
    <title>Obsidian Wing Chat</title>

    <style>
        body {
            width: 100%;
            height: 100%;
            margin: 0px;
            padding: 0px;
            overflow: hidden;
            font-family: "Roboto Flex";
        }

        /* CHAT AREA */

        #chat-area {
            position: absolute;
            left: 6%;
            right: 6%;
            bottom: 105px;
            height: 75%;
            display: block;
            overflow-y: auto;
            padding: 8px 0px;
        }

        /* CHAT BUBBLE */

        .chat-message {
            display: block;
            width: auto;
            max-width: 88%;
            margin-left: auto;
            margin-bottom: 10px;
            padding: 12px 16px;

            border: 1px #65dfff77;
            border-radius: 31px 12px 31px 12px;

            decorator: linear-gradient(
                125deg,
                #a9f2ff08 0%,
                #0878b51c 27%,
                #061a2b88 52%,
                #5bdcff08 100%
            ) border-box;

            box-shadow:
                #d6faff22 0px 0px 1px 0px inset,
                #d6faff44 1px 1px 2px 0px inset,
                #25aaff33 -1px -1px 3px 0px inset;

            color: #dffaff;
            font-size: 16px;
            line-height: 1.45;
            white-space: pre-wrap;
        }

        /* INPUT BAR */

        #input-bar {
            position: absolute;
            display: block;

            left: 6%;
            bottom: 30px;

            width: 58px;
            height: 58px;

            border: 1px #65dfff77;
            border-radius: 31px 12px 31px 12px;

            overflow: hidden;

            decorator: linear-gradient(
                125deg,
                #a9f2ff08 0%,
                #0878b51c 27%,
                #061a2b88 52%,
                #5bdcff08 100%
            ) border-box;

            box-shadow:
                #d6faff22 0px 0px 1px 0px inset,
                #d6faff44 1px 1px 2px 0px inset,
                #25aaff33 -1px -1px 3px 0px inset;

            transition:
                width 0.8s cubic-out,
                height 0.22s linear-in-out,
                border-radius 0.7s linear-in-out;
        }

        #input-bar.expanded {
            width: 88%;
        }

        /* WING HIT AREA */

        #wing-hit {
            position: absolute;
            left: 0px;
            bottom: 0px;

            width: 58px;
            height: 58px;

            z-index: 2;
        }

        /* WING DESIGN */

        #wing-button {
            position: absolute;
            left: 5px;
            bottom: 7px;

            width: 48px;
            height: 42px;

            pointer-events: none;

            transition: left 0.8s cubic-out;
        }

        #input-bar.expanded #wing-button {
            left: 4.2%;
        }

        /* MESSAGE INPUT */

        #message-input {
            position: absolute;

            left: 76px;
            right: 53px;
            top: 50%;

            width: auto;
            height: 30px;
            max-height: 118px;

            margin-top: -15px;
            padding: 3px 0px 2px 0px;

            font-size: 17px;
            line-height: 24px;

            color: #dffaff;
            background-color: transparent;

            border-width: 0px;
            border-color: transparent;

            overflow-y: auto;

            caret-color: #65dfff;

            opacity: 0;

            transition: opacity 0.25s linear-in-out;
        }

        #input-bar.expanded #message-input {
            opacity: 1;
        }

        /* SEND BUTTON */

        #send-button {
            position: absolute;

            right: 10px;
            bottom: 14.5px;

            width: 29px;
            height: 29px;

            opacity: 0;
        }

        #input-bar.expanded #send-button {
            opacity: 1;
        }

        /* PULSE AND ARROW */

        .pulse-icon {
            opacity: 1;
        }

        .arrow-icon {
            opacity: 0;
        }

        #input-bar.has-text .pulse-icon {
            opacity: 0;
        }

        #input-bar.has-text .arrow-icon {
            opacity: 1;
        }

    </style>
</head>

<body>

    <!-- CHAT AREA -->

    <div id="chat-area"></div>

    <!-- INPUT BAR -->

    <div id="input-bar">

        <!-- WING HIT AREA -->

        <div id="wing-hit"></div>

        <!-- WING SVG -->

        <svg id="wing-button"
             viewBox="0 0 54 44"
             xmlns="http://www.w3.org/2000/svg">

            <path
                d="M3 22L14 5H39L51 15L42 39H15L3 22Z"
                fill="#07131E"
                stroke="#5EDFF1"
                stroke-width="1.2"
                stroke-linejoin="round"/>

            <path
                d="M10 22L18 10H36L44 16L37 34H18L10 22Z"
                fill="none"
                stroke="#6ADCF0"
                stroke-opacity=".55"
                stroke-width=".8"/>

            <path
                d="M18 30L31 11L35 15L23 33Z"
                fill="#8BF1FF"
                fill-opacity=".16"
                stroke="#A4F6FF"
                stroke-width="1.1"/>

            <path
                d="M23 29L32 15"
                fill="none"
                stroke="#C0FCFF"
                stroke-width="2"
                stroke-linecap="round"/>

            <path
                d="M7 22H14M40 22H47"
                fill="none"
                stroke="#78E8F8"
                stroke-width="1"
                stroke-linecap="round"/>

        </svg>

        <!-- TEXT INPUT -->

        <textarea id="message-input" rows="1"></textarea>

        <!-- SEND SVG -->

        <svg id="send-button"
             viewBox="0 0 38 38"
             xmlns="http://www.w3.org/2000/svg">

            <g class="pulse-icon">

                <path
                    d="M9 12L13 9V31L9 28Z"
                    fill="#16495C"
                    stroke="#65DFF2"
                    stroke-width=".8"
                    stroke-linejoin="round"/>

                <path
                    d="M18 6L22 4V36L18 34Z"
                    fill="#247B96"
                    stroke="#9CEFFF"
                    stroke-width=".9"
                    stroke-linejoin="round"/>

                <path
                    d="M27 12L31 9V31L27 28Z"
                    fill="#16495C"
                    stroke="#65DFF2"
                    stroke-width=".8"
                    stroke-linejoin="round"/>

                <path
                    d="M13 10L13 30M22 5V35M31 10V30"
                    stroke="#D0FAFF"
                    stroke-opacity=".4"
                    stroke-width=".7"/>

            </g>

            <g class="arrow-icon">

                <path
                    d="M6 19.5L33 6L24.5 34L18.5 23L6 19.5Z"
                    fill="#16495C"
                    stroke="#83EDFF"
                    stroke-width="1.5"
                    stroke-linejoin="round"/>

                <path
                    d="M18.5 23L33 6"
                    stroke="#D0FAFF"
                    stroke-width="1.3"
                    stroke-linecap="round"/>

            </g>

        </svg>

    </div>

</body>
</rml>
