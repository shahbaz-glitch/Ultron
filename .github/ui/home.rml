<rml>
<head>
    <title>J.A.R.V.I.S. First Outer Ring</title>

    <style>
        rml,
        body {
            width: 100%;
            height: 100%;
            margin: 0px;
        }

        body {
            display: flex;
            justify-content: center;
            align-items: center;
            overflow: hidden;
        }

        /* Ring size — preserved */
        #hud-container {
            position: relative;
            width: 88vw;
            height: 88vw;
            flex-shrink: 0;
            display: flex;
            justify-content: center;
            align-items: center;
            overflow: visible;
        }

        @media (orientation: landscape) {
            #hud-container {
                width: 88vh;
                height: 88vh;
            }
        }

        /* OUTER RING — ANTICLOCKWISE */
        #ring-glow {
            position: absolute;
            top: 0px;
            left: 0px;
            width: 100%;
            height: 100%;
            flex-shrink: 0;
            filter: drop-shadow(#00BFFF 0px 0px 12px);
        }

        #outer-ring-rotation {
            position: absolute;
            top: 0px;
            left: 0px;
            width: 100%;
            height: 100%;
            transform-origin: 50% 50%;
            animation: 30s linear-in-out infinite outer-anticlockwise;
        }

        @keyframes outer-anticlockwise {
            from {
                transform: rotate(0deg);
            }

            to {
                transform: rotate(-360deg);
            }
        }

        /* SECOND RING — STATIC, WITH ORIGINAL GLOW */
        #second-ring-glow {
            position: absolute;
            top: 0px;
            left: 0px;
            width: 100%;
            height: 100%;
            flex-shrink: 0;
            filter: drop-shadow(#00BFFF 0px 0px 12px);
        }

        /* DETAIL RINGS AND TICKS — CLOCKWISE */
        #detail-rings {
            position: absolute;
            top: 0px;
            left: 0px;
            width: 100%;
            height: 100%;
            flex-shrink: 0;
            transform-origin: 50% 50%;
            animation: 24s linear-in-out infinite details-clockwise;
        }

        @keyframes details-clockwise {
            from {
                transform: rotate(0deg);
            }

            to {
                transform: rotate(360deg);
            }
        }

        /* SIXTH DOTTED RING — STATIC */
        #sixth-ring {
            position: absolute;
            top: 0px;
            left: 0px;
            width: 100%;
            height: 100%;
            flex-shrink: 0;
        }

        /* CENTER J.A.R.V.I.S. — STATIC */
        #jarvis-center {
            position: absolute;
            top: 0px;
            left: 0px;
            width: 100%;
            height: 100%;
            flex-shrink: 0;
        }

        #jarvis-outer-svg,
        #jarvis-second-svg,
        #jarvis-detail-rings,
        #jarvis-sixth-svg,
        #jarvis-center-svg {
            width: 100%;
            height: 100%;
        }
    </style>
</head>

<body>
    <div id="hud-container">

        <!-- FIRST RING — ANTICLOCKWISE -->
        <div id="ring-glow">
            <div id="outer-ring-rotation">
                <svg
                    id="jarvis-outer-svg"
                    viewBox="0 0 600 600"
                    xmlns="http://www.w3.org/2000/svg">

                    <g class="outer-ring-group">

                        <!-- Continuous cyan base -->
                        <circle
                            cx="300"
                            cy="300"
                            r="270"
                            fill="none"
                            stroke="#00d2ff"
                            stroke-width="14"
                        />

                        <!-- Cyan rim — four arcs -->
                        <g
                            fill="none"
                            stroke="#6be6ff"
                            stroke-width="16"
                            stroke-linecap="butt">

                            <path
                                d="M 569.9833 302.9999
                                   A 270 270 0 0 1 302.9999 569.9833"
                            />

                            <path
                                d="M 297.0001 569.9833
                                   A 270 270 0 0 1 30.0167 302.9999"
                            />

                            <path
                                d="M 30.0167 297.0001
                                   A 270 270 0 0 1 297.0001 30.0167"
                            />

                            <path
                                d="M 302.9999 30.0167
                                   A 270 270 0 0 1 569.9833 297.0001"
                            />

                        </g>

                        <!-- White ring — same four cuts -->
                        <g
                            fill="none"
                            stroke="#ffffff"
                            stroke-width="16"
                            stroke-linecap="butt">

                            <path
                                d="M 569.9833 302.9999
                                   A 270 270 0 0 1 302.9999 569.9833"
                            />

                            <path
                                d="M 297.0001 569.9833
                                   A 270 270 0 0 1 30.0167 302.9999"
                            />

                            <path
                                d="M 30.0167 297.0001
                                   A 270 270 0 0 1 297.0001 30.0167"
                            />

                            <path
                                d="M 302.9999 30.0167
                                   A 270 270 0 0 1 569.9833 297.0001"
                            />

                        </g>

                    </g>
                </svg>
            </div>
        </div>

        <!-- SECOND RING — STATIC -->
        <div id="second-ring-glow">
            <svg
                id="jarvis-second-svg"
                viewBox="0 0 600 600"
                xmlns="http://www.w3.org/2000/svg">

                <g class="second-ring-group">

                    <circle
                        cx="300"
                        cy="300"
                        r="244"
                        fill="none"
                        stroke="#00d2ff"
                        stroke-width="14"
                    />

                    <circle
                        cx="300"
                        cy="300"
                        r="244"
                        fill="none"
                        stroke="#6be6ff"
                        stroke-width="16"
                    />

                    <circle
                        cx="300"
                        cy="300"
                        r="244"
                        fill="none"
                        stroke="#ffffff"
                        stroke-width="18"
                    />

                </g>
            </svg>
        </div>

        <!-- THIRD, FOURTH AND FIFTH RINGS — CLOCKWISE -->
        <div id="detail-rings">
            <svg
                id="jarvis-detail-rings"
                viewBox="0 0 600 600"
                xmlns="http://www.w3.org/2000/svg">

                <!-- THIRD RING -->
                <g
                    class="third-ring-group"
                    fill="none"
                    stroke="#00dfff"
                    stroke-width="2.5"
                    stroke-linecap="butt">

                    <path
                        d="M 521.6818 305.5000
                           A 221.75 221.75 0 0 1 193.9222 494.7321"
                    />

                    <path
                        d="M 184.3960 489.2321
                           A 221.75 221.75 0 0 1 184.3960 110.7679"
                    />

                    <path
                        d="M 193.9222 105.2679
                           A 221.75 221.75 0 0 1 521.6818 294.5000"
                    />

                </g>

                <!-- THIRD RING — WHITE ENDPOINT DOT PAIRS -->
                <g class="third-ring-dots" fill="#ffffff">

                    <circle cx="521.6818" cy="305.5000" r="4.5"/>
                    <circle cx="521.6818" cy="294.5000" r="4.5"/>

                    <circle cx="193.9222" cy="494.7321" r="4.5"/>
                    <circle cx="184.3960" cy="489.2321" r="4.5"/>

                    <circle cx="184.3960" cy="110.7679" r="4.5"/>
                    <circle cx="193.9222" cy="105.2679" r="4.5"/>

                </g>

                <!-- FOURTH RING — THIN SEGMENTS -->
                <g
                    class="fourth-ring-thin-segments"
                    fill="none"
                    stroke="#00dfff"
                    stroke-width="2.5"
                    stroke-linecap="butt">

                    <path
                        d="M 478.5838 397.0484
                           A 203.25 203.25 0 0 1 294.7546 503.1823"
                    />

                    <path
                        d="M 126.6617 406.1339
                           A 203.25 203.25 0 0 1 126.6617 193.8661"
                    />

                    <path
                        d="M 294.7546 96.8177
                           A 203.25 203.25 0 0 1 478.5838 202.9516"
                    />

                </g>

                <!-- FOURTH RING — ADDED ARCS, THIN PORTIONS -->
                <g
                    class="fourth-ring-added-arcs"
                    fill="none"
                    stroke="#00cfff"
                    stroke-width="4.5"
                    stroke-linecap="butt">

                    <path
                        d="M 482.2646 210.0545
                           A 203.25 203.25 0 0 1 482.2646 389.9455"
                    />

                    <path
                        d="M 286.7628 502.8185
                           A 203.25 203.25 0 0 1 130.9726 412.8730"
                    />

                    <path
                        d="M 130.9726 187.1270
                           A 203.25 203.25 0 0 1 286.7628 97.1815"
                    />

                </g>

                <!-- FOURTH RING — THICK PORTIONS -->
                <g
                    class="fourth-ring-thick-portions"
                    fill="none"
                    stroke="#00cfff"
                    stroke-width="9"
                    stroke-linecap="butt">

                    <path
                        d="M 503.25 300
                           A 203.25 203.25 0 0 1 482.2646 389.9455"
                    />

                    <path
                        d="M 286.7628 502.8185
                           A 203.25 203.25 0 0 1 198.3750 476.0197"
                    />

                    <path
                        d="M 130.9726 187.1270
                           A 203.25 203.25 0 0 1 198.3750 123.9803"
                    />

                </g>

                <!-- FIFTH RING — THREE EQUAL SEGMENTS -->
                <g
                    class="fifth-ring-group"
                    fill="none"
                    stroke="#00dfff"
                    stroke-width="2.5"
                    stroke-linecap="butt">

                    <path
                        d="M 468.6748 361.3926
                           A 179.5 179.5 0 0 1 268.8301 476.7730"
                    />

                    <path
                        d="M 162.4950 415.3804
                           A 179.5 179.5 0 0 1 162.4950 184.6196"
                    />

                    <path
                        d="M 268.8301 123.2270
                           A 179.5 179.5 0 0 1 468.6748 238.6074"
                    />

                </g>

                <!-- FIFTH RING — RADIAL TICKS -->
                <g
                    class="fifth-ring-radial-ticks"
                    fill="none"
                    stroke="#00dfff"
                    stroke-linecap="butt">

                    <!-- TICK CLUSTER 1 -->
                    <g transform="rotate(0 300 300)">

                        <g stroke-width="3.5">

                            <line x1="470" y1="300" x2="480" y2="300"
                                  transform="rotate(-13.5 300 300)"/>

                            <line x1="470" y1="300" x2="480" y2="300"
                                  transform="rotate(0 300 300)"/>

                            <line x1="470" y1="300" x2="480" y2="300"
                                  transform="rotate(13.5 300 300)"/>

                        </g>

                        <g stroke-width="3.8">

                            <line x1="469.5" y1="300" x2="481" y2="300"
                                  transform="rotate(-9 300 300)"/>

                            <line x1="469.5" y1="300" x2="481" y2="300"
                                  transform="rotate(9 300 300)"/>

                        </g>

                        <g stroke-width="3.5">

                            <line x1="470" y1="300" x2="482" y2="300"
                                  transform="rotate(-4.5 300 300)"/>

                            <line x1="470" y1="300" x2="482" y2="300"
                                  transform="rotate(4.5 300 300)"/>

                        </g>

                    </g>

                    <!-- TICK CLUSTER 2 -->
                    <g transform="rotate(120 300 300)">

                        <g stroke-width="3.5">

                            <line x1="470" y1="300" x2="480" y2="300"
                                  transform="rotate(-13.5 300 300)"/>

                            <line x1="470" y1="300" x2="480" y2="300"
                                  transform="rotate(0 300 300)"/>

                            <line x1="470" y1="300" x2="480" y2="300"
                                  transform="rotate(13.5 300 300)"/>

                        </g>

                        <g stroke-width="3.8">

                            <line x1="469.5" y1="300" x2="481" y2="300"
                                  transform="rotate(-9 300 300)"/>

                            <line x1="469.5" y1="300" x2="481" y2="300"
                                  transform="rotate(9 300 300)"/>

                        </g>

                        <g stroke-width="3.5">

                            <line x1="470" y1="300" x2="482" y2="300"
                                  transform="rotate(-4.5 300 300)"/>

                            <line x1="470" y1="300" x2="482" y2="300"
                                  transform="rotate(4.5 300 300)"/>

                        </g>

                    </g>

                    <!-- TICK CLUSTER 3 -->
                    <g transform="rotate(240 300 300)">

                        <g stroke-width="3.5">

                            <line x1="470" y1="300" x2="480" y2="300"
                                  transform="rotate(-13.5 300 300)"/>

                            <line x1="470" y1="300" x2="480" y2="300"
                                  transform="rotate(0 300 300)"/>

                            <line x1="470" y1="300" x2="480" y2="300"
                                  transform="rotate(13.5 300 300)"/>

                        </g>

                        <g stroke-width="3.8">

                            <line x1="469.5" y1="300" x2="481" y2="300"
                                  transform="rotate(-9 300 300)"/>

                            <line x1="469.5" y1="300" x2="481" y2="300"
                                  transform="rotate(9 300 300)"/>

                        </g>

                        <g stroke-width="3.5">

                            <line x1="470" y1="300" x2="482" y2="300"
                                  transform="rotate(-4.5 300 300)"/>

                            <line x1="470" y1="300" x2="482" y2="300"
                                  transform="rotate(4.5 300 300)"/>

                        </g>

                    </g>

                </g>

            </svg>
        </div>

        <!-- SIXTH DOTTED RING — STATIC -->
        <div id="sixth-ring">
            <svg
                id="jarvis-sixth-svg"
                viewBox="0 0 600 600"
                xmlns="http://www.w3.org/2000/svg">

                <circle
                    class="sixth-ring-dot-circle"
                    cx="300"
                    cy="300"
                    r="156"
                    fill="none"
                    stroke="#00dfff"
                    stroke-width="4"
                    stroke-dasharray="0.1 16"
                    stroke-linecap="round"
                />

            </svg>
        </div>

        <!-- J.A.R.V.I.S. VECTOR LETTERING — STATIC -->
        <div id="jarvis-center">
            <svg
                id="jarvis-center-svg"
                viewBox="0 0 600 600"
                xmlns="http://www.w3.org/2000/svg">

                <defs>
                    <linearGradient
                        id="jarvis-letter-gradient"
                        x1="0"
                        y1="294"
                        x2="0"
                        y2="320"
                        gradientUnits="userSpaceOnUse">

                        <stop offset="0" stop-color="#ffffff"/>
                        <stop offset="0.38" stop-color="#e8fcff"/>
                        <stop offset="0.76" stop-color="#b9f2ff"/>
                        <stop offset="1" stop-color="#56d9f4"/>

                    </linearGradient>

                    <filter
                        id="jarvis-letter-glow"
                        x="-10%"
                        y="-30%"
                        width="120%"
                        height="160%">

                        <feGaussianBlur stdDeviation="1.3" result="blur"/>

                        <feMerge>
                            <feMergeNode in="blur"/>
                            <feMergeNode in="SourceGraphic"/>
                        </feMerge>

                    </filter>
                </defs>

                <!-- ACCEPTED J.A.R.V.I.S. COMPOUND VECTOR PATH -->
                <path
                    d="M 408.87 314.92 L 408.47 315.32 L 408.47 318.95 L 408.87 319.35 L 412.9 319.35 L 413.31 318.95 L 413.31 315.32 L 412.9 314.92 Z
                       M 370.16 314.92 L 369.76 315.32 L 369.76 318.55 L 370.56 319.35 L 374.19 319.35 L 374.6 318.95 L 374.6 315.32 L 374.19 314.92 Z
                       M 344.35 314.92 L 343.95 315.32 L 343.95 318.95 L 344.35 319.35 L 348.39 319.35 L 348.79 318.95 L 348.79 315.32 L 348.39 314.92 Z
                       M 309.68 314.92 L 309.27 315.32 L 309.27 319.35 L 313.71 319.35 L 314.11 318.55 L 314.11 315.73 L 313.71 314.92 Z
                       M 266.94 314.92 L 266.53 315.32 L 266.53 318.95 L 266.94 319.35 L 270.97 319.35 L 271.37 318.95 L 271.37 315.32 L 270.97 314.92 Z
                       M 217.74 314.92 L 216.94 316.13 L 216.94 318.55 L 217.34 319.35 L 221.77 319.35 L 222.18 318.95 L 222.18 316.94 L 222.58 316.53 L 221.77 314.92 Z
                       M 385.89 295.56 L 383.87 297.18 L 382.26 300.81 L 382.26 303.63 L 383.47 306.85 L 385.89 308.87 L 388.31 309.68 L 397.18 309.68 L 398.79 310.89 L 399.19 311.69 L 399.19 313.31 L 397.58 315.32 L 383.47 315.32 L 383.47 319.76 L 398.39 319.76 L 401.21 318.55 L 402.82 317.34 L 404.03 314.92 L 404.03 309.68 L 403.23 308.06 L 401.61 306.45 L 398.79 305.24 L 390.32 305.24 L 389.11 304.84 L 387.5 302.82 L 387.5 301.21 L 388.71 299.6 L 389.92 299.6 L 390.32 299.19 L 390.73 299.6 L 400.81 299.6 L 401.21 299.19 L 402.42 299.19 L 402.42 295.16 L 402.02 294.76 L 388.31 294.76 Z
                       M 357.66 294.76 L 357.26 295.16 L 357.26 319.35 L 357.66 319.76 L 362.1 319.76 L 362.5 318.95 L 362.1 318.15 L 362.5 317.34 L 362.1 316.94 L 362.1 315.32 L 362.5 314.92 L 362.5 295.97 L 362.1 295.16 Z
                       M 317.74 294.76 L 317.74 296.37 L 318.95 298.39 L 318.95 299.19 L 319.76 300.4 L 319.76 301.21 L 320.56 302.42 L 322.18 307.26 L 325 312.9 L 325 313.71 L 325.81 314.92 L 325.81 315.73 L 327.82 319.76 L 332.66 319.76 L 333.06 319.35 L 333.47 319.76 L 334.27 318.95 L 335.89 315.32 L 335.89 314.52 L 337.5 311.69 L 337.9 309.68 L 339.11 307.66 L 339.11 306.85 L 339.92 305.65 L 339.92 304.84 L 340.73 303.63 L 340.73 302.82 L 342.74 298.79 L 343.95 295.16 L 343.15 294.76 L 342.74 295.16 L 340.73 295.16 L 340.32 294.76 L 338.71 295.16 L 337.1 298.79 L 337.1 299.6 L 336.29 300.81 L 336.29 301.61 L 335.48 302.82 L 335.48 303.63 L 334.68 304.84 L 334.68 305.65 L 333.87 306.85 L 333.87 307.66 L 333.06 308.87 L 333.06 309.68 L 332.26 310.89 L 331.45 313.71 L 330.65 314.11 L 329.44 312.1 L 329.03 310.08 L 328.23 308.87 L 328.23 308.06 L 327.42 306.85 L 327.42 306.05 L 326.61 304.84 L 326.61 304.03 L 325.81 302.82 L 324.19 297.98 L 322.98 295.97 L 322.98 295.16 L 322.18 294.76 Z
                       M 279.84 294.76 L 279.44 295.16 L 279.44 319.35 L 279.84 319.76 L 281.85 319.76 L 282.26 319.35 L 283.87 319.76 L 284.27 319.35 L 284.27 311.29 L 285.08 310.08 L 289.52 310.08 L 296.77 319.76 L 302.02 319.76 L 302.02 318.95 L 296.37 311.29 L 296.37 310.48 L 297.18 309.68 L 299.6 308.87 L 300.81 307.66 L 302.02 304.84 L 302.02 300 L 301.21 297.98 L 299.19 295.97 L 295.56 294.76 Z
                       M 284.68 300 L 285.48 299.19 L 294.35 299.19 L 295.97 300 L 296.77 301.21 L 296.77 304.44 L 294.76 306.05 L 285.08 306.05 L 284.68 305.65 Z
                       M 241.94 295.16 L 239.11 300.81 L 238.31 301.61 L 237.1 304.03 L 237.1 304.84 L 233.06 312.5 L 233.06 313.31 L 229.84 319.35 L 230.24 319.76 L 231.45 319.76 L 231.85 319.35 L 235.08 319.76 L 238.31 314.11 L 251.61 314.11 L 254.03 318.95 L 254.84 319.76 L 255.24 319.35 L 258.47 319.35 L 259.68 319.76 L 260.08 319.35 L 248.39 295.56 L 247.18 294.76 L 243.95 294.76 L 243.55 295.16 L 242.74 294.76 Z
                       M 245.16 300.4 L 245.97 301.21 L 245.97 302.02 L 248.39 306.45 L 249.19 309.27 L 248.79 309.68 L 241.53 310.08 L 240.73 309.27 L 240.73 308.06 L 243.95 302.02 L 243.95 301.21 Z
                       M 208.47 295.16 L 204.44 295.16 L 204.03 294.76 L 203.63 295.16 L 203.63 312.9 L 203.23 313.71 L 201.61 315.32 L 193.15 315.32 L 191.94 314.11 L 191.94 313.31 L 191.13 312.5 L 189.92 312.9 L 188.31 312.9 L 187.5 312.5 L 186.69 313.31 L 187.1 313.71 L 187.1 316.13 L 188.71 318.55 L 190.32 319.35 L 192.34 319.35 L 192.74 319.76 L 202.82 319.76 L 204.84 318.95 L 207.26 316.94 L 208.87 313.31 L 208.87 304.84 L 208.47 304.44 L 208.87 303.63 L 208.87 300 L 208.47 299.6 Z"
                    fill="url(#jarvis-letter-gradient)"
                    fill-rule="evenodd"
                    stroke="#bdf4ff"
                    stroke-width="0.12"
                    filter="url(#jarvis-letter-glow)"
                />

            </svg>
        </div>

    </div>
</body>
</rml>
