
<rml>
<head>
    <title>J.A.R.V.I.S. First Outer Ring</title>

    <style>
        rml,
        body {
            width: 100%;
            height: 100%;
            margin: 0px;
        }

        body {
            display: flex;
            justify-content: center;
            align-items: center;
            overflow: hidden;
        }

        /* Ring size — unchanged */
        #hud-container {
            position: relative;
            width: 88vw;
            height: 88vw;
            flex-shrink: 0;
            display: flex;
            justify-content: center;
            align-items: center;
            overflow: visible;
        }

        @media (orientation: landscape) {
            #hud-container {
                width: 88vh;
                height: 88vh;
            }
        }

        /* Original cyan-blue glow — unchanged */
        #ring-glow {
            width: 100%;
            height: 100%;
            flex-shrink: 0;

            filter: drop-shadow(#00BFFF 0px 0px 12px);
        }

        #jarvis-ring {
            width: 100%;
            height: 100%;
        }
    </style>
</head>

<body>
    <div id="hud-container">

        <div id="ring-glow">
            <svg
                id="jarvis-ring"
                viewBox="0 0 600 600"
                xmlns="http://www.w3.org/2000/svg">

                <!-- FIRST RING -->
                <g class="outer-ring-group">

                    <!-- Continuous cyan base — fills the four gaps -->
                    <circle
                        cx="300"
                        cy="300"
                        r="270"
                        fill="none"
                        stroke="#00d2ff"
                        stroke-width="14"
                    />

                    <!-- Cyan rim — four equal arcs, 6-unit gaps -->
                    <g
                        fill="none"
                        stroke="#6be6ff"
                        stroke-width="16"
                        stroke-linecap="butt">

                        <!-- Segment 1 -->
                        <path
                            d="M 569.9833 302.9999
                               A 270 270 0 0 1 302.9999 569.9833"
                        />

                        <!-- Segment 2 -->
                        <path
                            d="M 297.0001 569.9833
                               A 270 270 0 0 1 30.0167 302.9999"
                        />

                        <!-- Segment 3 -->
                        <path
                            d="M 30.0167 297.0001
                               A 270 270 0 0 1 297.0001 30.0167"
                        />

                        <!-- Segment 4 -->
                        <path
                            d="M 302.9999 30.0167
                               A 270 270 0 0 1 569.9833 297.0001"
                        />

                    </g>

                    <!-- White ring — same four cuts -->
                    <g
                        fill="none"
                        stroke="#ffffff"
                        stroke-width="16"
                        stroke-linecap="butt">

                        <!-- Segment 1 -->
                        <path
                            d="M 569.9833 302.9999
                               A 270 270 0 0 1 302.9999 569.9833"
                        />

                        <!-- Segment 2 -->
                        <path
                            d="M 297.0001 569.9833
                               A 270 270 0 0 1 30.0167 302.9999"
                        />

                        <!-- Segment 3 -->
                        <path
                            d="M 30.0167 297.0001
                               A 270 270 0 0 1 297.0001 30.0167"
                        />

                        <!-- Segment 4 -->
                        <path
                            d="M 302.9999 30.0167
                               A 270 270 0 0 1 569.9833 297.0001"
                        />

                    </g>

                </g>

                <!-- SECOND RING — UNCHANGED -->
                <g class="second-ring-group">

                    <!-- Inner outer cyan layer -->
                    <circle
                        cx="300"
                        cy="300"
                        r="244"
                        fill="none"
                        stroke="#00d2ff"
                        stroke-width="14"
                    />

                    <!-- Inner cyan rim -->
                    <circle
                        cx="300"
                        cy="300"
                        r="244"
                        fill="none"
                        stroke="#6be6ff"
                        stroke-width="16"
                    />

                    <!-- Inner sharp white ring — 18px -->
                    <circle
                        cx="300"
                        cy="300"
                        r="244"
                        fill="none"
                        stroke="#ffffff"
                        stroke-width="18"
                    />

                </g>

                <!-- THIRD RING — 8 SVG UNITS FROM SECOND RING -->
                <g
                    class="third-ring-group"
                    fill="none"
                    stroke="#00dfff"
                    stroke-width="2.5"
                    stroke-linecap="butt">

                    <!-- Segment 1 -->
                    <path
                        d="M 525.6830 305.5000
                           A 225.75 225.75 0 0 1 191.9216 498.1972"
                    />

                    <!-- Segment 2 -->
                    <path
                        d="M 182.3954 492.6972
                           A 225.75 225.75 0 0 1 182.3954 107.3028"
                    />

                    <!-- Segment 3 -->
                    <path
                        d="M 191.9216 101.8028
                           A 225.75 225.75 0 0 1 525.6830 294.5000"
                    />

                </g>

                <!-- THIRD RING — WHITE ENDPOINT DOT PAIRS -->
                <g
                    class="third-ring-dots"
                    fill="#ffffff">

                    <!-- Pair 1 — right side -->
                    <circle cx="525.6830" cy="305.5000" r="4.5"/>
                    <circle cx="525.6830" cy="294.5000" r="4.5"/>

                    <!-- Pair 2 — lower-left side -->
                    <circle cx="191.9216" cy="498.1972" r="4.5"/>
                    <circle cx="182.3954" cy="492.6972" r="4.5"/>

                    <!-- Pair 3 — upper-left side -->
                    <circle cx="182.3954" cy="107.3028" r="4.5"/>
                    <circle cx="191.9216" cy="101.8028" r="4.5"/>

                </g>

                <!-- FOURTH RING — LATEST DESIGN -->
                <!-- Thin cyan segments -->
                <g
                    class="fourth-ring-thin-segments"
                    fill="none"
                    stroke="#00dfff"
                    stroke-width="2.5"
                    stroke-linecap="butt">

                    <!-- Segment 1 -->
                    <path
                        d="M 483.9301 399.7760
                           A 209.25 209.25 0 0 1 294.4435 509.1762"
                    />

                    <!-- Segment 2 -->
                    <path
                        d="M 121.6263 409.4002
                           A 209.25 209.25 0 0 1 121.6263 190.5998"
                    />

                    <!-- Segment 3 -->
                    <path
                        d="M 294.4435 90.8238
                           A 209.25 209.25 0 0 1 483.9301 200.2240"
                    />

                </g>

                <!-- FOURTH RING — ADDED ARCS -->
                <!-- Thin portion: 4.5 SVG units -->
                <g
                    class="fourth-ring-added-arcs"
                    fill="none"
                    stroke="#00cfff"
                    stroke-width="4.5"
                    stroke-linecap="butt">

                    <!-- Added arc 1 -->
                    <path
                        d="M 487.5759 207.2592
                           A 209.25 209.25 0 0 1 487.5759 392.7408"
                    />

                    <!-- Added arc 2 -->
                    <path
                        d="M 286.5280 508.8158
                           A 209.25 209.25 0 0 1 125.8962 416.0751"
                    />

                    <!-- Added arc 3 -->
                    <path
                        d="M 125.8962 183.9249
                           A 209.25 209.25 0 0 1 286.5280 91.1842"
                    />

                </g>

                <!-- FOURTH RING — THICK PORTIONS -->
                <!-- Thickness: 9 SVG units -->
                <g
                    class="fourth-ring-thick-portions"
                    fill="none"
                    stroke="#00cfff"
                    stroke-width="9"
                    stroke-linecap="butt">

                    <!-- Thick portion 1 -->
                    <path
                        d="M 509.25 300
                           A 209.25 209.25 0 0 1 487.5759 392.7408"
                    />

                    <!-- Thick portion 2 -->
                    <path
                        d="M 286.5280 508.8158
                           A 209.25 209.25 0 0 1 195.3750 481.2158"
                    />

                    <!-- Thick portion 3 -->
                    <path
                        d="M 125.8962 183.9249
                           A 209.25 209.25 0 0 1 195.3750 118.7842"
                    />

                </g>

            </svg>
        </div>

    </div>
</body>
</rml>
