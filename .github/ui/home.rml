<rml>
    <head>
        <style>
            #root {
                width: 100%;
                height: 100%;
                display: flex;
                flex-direction: column;
                align-items: center;
                justify-content: center;
            }

            #show-circle {
                width: 200dp;
                height: 50dp;
                border: 1dp #287F9F;
                border-radius: 10dp;
                background-color: #0D2431;
            }

            #red-circle {
                display: none;
                width: 72dp;
                height: 72dp;
                margin-top: 18dp;
                border-radius: 36dp;
                background-color: #FF304F;
            }

            #red-circle.visible {
                display: block;
            }
        </style>
    </head>

    <body>
        <div id="root">
            <button id="show-circle"
                    data-action="show-red-circle">
            </button>

            <div id="red-circle"></div>
        </div>
    </body>
</rml>
