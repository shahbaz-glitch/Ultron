<rml>
    <head>
        <title>Jarvis HUD Border</title>

        <style>
            body {
                width: 100%;
                height: 100%;
                margin: 0;
                padding: 0;
                overflow: hidden;
            }

            #hud-border {
                position: absolute;
                left: 0;
                top: 0;
                width: 100%;
                height: 100%;
            }
        </style>
    </head>

    <body>
        <svg id="hud-border"
             viewBox="0 0 420 900"
             preserveAspectRatio="none"
             xmlns="http://www.w3.org/2000/svg">

            <!-- Subtle cyan glow -->
            <path
                d="M12 77
                   L25 64
                   H151
                   L163 74
                   H257
                   L269 64
                   H395
                   L408 77
                   V866
                   L395 879
                   H25
                   L12 866 Z"
                fill="none"
                stroke="#00DFFF"
                stroke-width="5"
                opacity="0.18"
                stroke-linejoin="round"/>

            <!-- Sharp neon border -->
            <path
                d="M12 77
                   L25 64
                   H151
                   L163 74
                   H257
                   L269 64
                   H395
                   L408 77
                   V866
                   L395 879
                   H25
                   L12 866 Z"
                fill="none"
                stroke="#00DFFF"
                stroke-width="2.6"
                stroke-linejoin="round"/>
        </svg>
    </body>
</rml>
