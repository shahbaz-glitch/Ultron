<rml>
<head>
    <title>J.A.R.V.I.S. First Outer Ring</title>

    <style>
        rml,
        body {
            width: 100%;
            height: 100%;
            margin: 0px;
        }

        body {
            display: flex;
            justify-content: center;
            align-items: center;
            overflow: hidden;
        }

        /* Ring size — unchanged */
        #hud-container {
            position: relative;
            width: 88vw;
            height: 88vw;
            flex-shrink: 0;
            display: flex;
            justify-content: center;
            align-items: center;
            overflow: visible;
        }

        @media (orientation: landscape) {
            #hud-container {
                width: 88vh;
                height: 88vh;
            }
        }

        /* Original cyan-blue glow — unchanged */
        #ring-glow {
            width: 100%;
            height: 100%;
            flex-shrink: 0;

            filter: drop-shadow(#00BFFF 0px 0px 12px);
        }

        #jarvis-ring {
            width: 100%;
            height: 100%;
        }
    </style>
</head>

<body>
    <div id="hud-container">

        <div id="ring-glow">
            <svg
                id="jarvis-ring"
                viewBox="0 0 600 600"
                xmlns="http://www.w3.org/2000/svg">

                <!-- FIRST RING -->
                <g class="outer-ring-group">

                    <!-- Continuous cyan base — fills the four gaps -->
                    <circle
                        cx="300"
                        cy="300"
                        r="270"
                        fill="none"
                        stroke="#00d2ff"
                        stroke-width="14"
                    />

                    <!-- Cyan rim — four equal arcs, 6-unit gaps -->
                    <g
                        fill="none"
                        stroke="#6be6ff"
                        stroke-width="16"
                        stroke-linecap="butt">

                        <!-- Segment 1 -->
                        <path
                            d="M 569.9833 302.9999
                               A 270 270 0 0 1 302.9999 569.9833"
                        />

                        <!-- Segment 2 -->
                        <path
                            d="M 297.0001 569.9833
                               A 270 270 0 0 1 30.0167 302.9999"
                        />

                        <!-- Segment 3 -->
                        <path
                            d="M 30.0167 297.0001
                               A 270 270 0 0 1 297.0001 30.0167"
                        />

                        <!-- Segment 4 -->
                        <path
                            d="M 302.9999 30.0167
                               A 270 270 0 0 1 569.9833 297.0001"
                        />

                    </g>

                    <!-- White ring — same four cuts -->
                    <g
                        fill="none"
                        stroke="#ffffff"
                        stroke-width="16"
                        stroke-linecap="butt">

                        <!-- Segment 1 -->
                        <path
                            d="M 569.9833 302.9999
                               A 270 270 0 0 1 302.9999 569.9833"
                        />

                        <!-- Segment 2 -->
                        <path
                            d="M 297.0001 569.9833
                               A 270 270 0 0 1 30.0167 302.9999"
                        />

                        <!-- Segment 3 -->
                        <path
                            d="M 30.0167 297.0001
                               A 270 270 0 0 1 297.0001 30.0167"
                        />

                        <!-- Segment 4 -->
                        <path
                            d="M 302.9999 30.0167
                               A 270 270 0 0 1 569.9833 297.0001"
                        />

                    </g>

                </g>

                <!-- SECOND RING — UNCHANGED -->
                <g class="second-ring-group">

                    <!-- Inner outer cyan layer -->
                    <circle
                        cx="300"
                        cy="300"
                        r="244"
                        fill="none"
                        stroke="#00d2ff"
                        stroke-width="14"
                    />

                    <!-- Inner cyan rim -->
                    <circle
                        cx="300"
                        cy="300"
                        r="244"
                        fill="none"
                        stroke="#6be6ff"
                        stroke-width="16"
                    />

                    <!-- Inner sharp white ring — 18px -->
                    <circle
                        cx="300"
                        cy="300"
                        r="244"
                        fill="none"
                        stroke="#ffffff"
                        stroke-width="18"
                    />

                </g>

            </svg>
        </div>

    </div>
</body>
</rml>
