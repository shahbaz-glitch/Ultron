<rml>
<head>
    <title>Obsidian Wing Chat</title>
    <style>
body {
    width: 100%;
    height: 100%;
    margin: 0px;
    padding: 0px;
    overflow: hidden;
    font-family: "Roboto Flex";
}

/* CHAT AREA */

#chat-area {
    position: absolute;
    left: 6%;
    right: 6%;
    bottom: 25.74vw;
    height: 75%;
    display: block;
    overflow-y: auto;
    padding: 1.96vw 0px;
}

/* CHAT BUBBLE */

.chat-message {
    display: block;
    width: auto;
    max-width: 88%;
    margin-left: auto;
    margin-bottom: 2.45vw;
    padding: 2.94vw 3.92vw;

    border: 0.25vw #65dfff77;
    border-radius: 7.60vw 2.94vw 7.60vw 2.94vw;

    decorator: linear-gradient(
        125deg,
        #a9f2ff08 0%,
        #0878b51c 27%,
        #061a2b88 52%,
        #5bdcff08 100%
    ) border-box;

    box-shadow:
        #d6faff44 0.25vw 0.25vw 0.49vw 0px inset,
        #25aaff33 -0.25vw -0.25vw 0.74vw 0px inset;

    color: #dffaff;
    font-size: 3.92vw;
    line-height: 1.45;
    white-space: pre-wrap;
}

/* INPUT BAR */

#input-bar {
    position: absolute;
    display: block;

    left: 6%;
    bottom: 7.35vw;

    width: 14.22vw;
    height: 14.22vw;

    border: 0.25vw #65dfff77;
    border-radius: 7.60vw 2.94vw 7.60vw 2.94vw;

    overflow: hidden;

    decorator: linear-gradient(
        125deg,
        #a9f2ff08 0%,
        #0878b51c 27%,
        #061a2b88 52%,
        #5bdcff08 100%
    ) border-box;

    box-shadow:
        #d6faff44 0.25vw 0.25vw 0.49vw 0px inset,
        #25aaff33 -0.25vw -0.25vw 0.74vw 0px inset;

    transition:
        width 0.8s cubic-out,
        border-radius 0.7s linear-in-out;
}

#input-bar.expanded {
    width: 88%;
}

/* WING HIT AREA */

#wing-hit {
    position: absolute;
    left: 0px;
    bottom: 0px;

    width: 14.22vw;
    height: 14.22vw;

    z-index: 2;
}

/* WING DESIGN */

#wing-button {
    position: absolute;
    left: 1.23vw;
    bottom: 1.72vw;

    width: 11.76vw;
    height: 10.29vw;

    pointer-events: none;

    transition: left 0.8s cubic-out;
}

#input-bar.expanded #wing-button {
    left: 4.2%;
}

/* INPUT SCROLL VIEWPORT (Handles 4-line max height + vertical scroll) */

#input-scroll {
    position: absolute;

    left: 18.63vw;
    right: 12.99vw;
    top: 50%;

    width: auto;
    height: 7.35vw;

    margin-top: -3.68vw;

    overflow-x: hidden;
    overflow-y: hidden;
}

#input-bar.multiline #input-scroll {
    left: 4.17vw;
    right: 2.45vw;
    top: 2.24vw;

    width: auto;
    margin-top: 0px;

    overflow-x: hidden;
    overflow-y: auto;
}

#input-scroll scrollbarvertical {
    width: 0px;
}

#input-scroll scrollbarhorizontal {
    height: 0px;
}

/* MESSAGE INPUT (Never vertically overflows internally) */

#message-input {
    position: relative;
    display: block;

    width: 100%;
    height: 100%;

    padding: 0.74vw 0px 0.49vw 0px;

    font-size: 4.17vw;
    line-height: 5.88vw;

    color: #dffaff;
    background-color: transparent;

    border-width: 0px;
    border-color: transparent;

    overflow: hidden;

    caret-color: #65dfff;

    opacity: 0;

    transition: opacity 0.15s linear-in-out;
}

#input-bar.expanded #message-input {
    opacity: 1;
}

#input-bar.multiline #message-input {
    padding: 0px;
    overflow: hidden;
}

/* SEND BUTTON */

#send-button {
    position: absolute;

    display: none;

    right: 2.45vw;
    bottom: 3.55vw;

    width: 7.11vw;
    height: 7.11vw;

    opacity: 0;
}

#input-bar.expanded #send-button {
    display: block;
    opacity: 1;
}

/* PULSE AND ARROW WRAPPERS */

#send-button .pulse-icon,
#send-button .arrow-icon {
    position: absolute;

    left: 0px;
    top: 0px;

    width: 100%;
    height: 100%;

    transition: opacity 0.15s linear-in-out;
}

#send-button .pulse-icon svg,
#send-button .arrow-icon svg {
    width: 100%;
    height: 100%;
    display: block;
}

.pulse-icon {
    opacity: 1;
}

.arrow-icon {
    opacity: 0;
}

#input-bar.has-text .pulse-icon {
    opacity: 0;
}

#input-bar.has-text .arrow-icon {
    opacity: 1;
}

/* LANDSCAPE RESPONSIVE SCALING */

@media (orientation: landscape) {

    #chat-area {
        bottom: 25.74vh;
        padding: 1.96vh 0px;
    }

    .chat-message {
        margin-bottom: 2.45vh;
        padding: 2.94vh 3.92vh;

        border: 0.25vh #65dfff77;
        border-radius: 7.60vh 2.94vh 7.60vh 2.94vh;

        box-shadow:
            #d6faff44 0.25vh 0.25vh 0.49vh 0px inset,
            #25aaff33 -0.25vh -0.25vh 0.74vh 0px inset;

        font-size: 3.92vh;
    }

    #input-bar {
        bottom: 7.35vh;

        width: 14.22vh;
        height: 14.22vh;

        border: 0.25vh #65dfff77;
        border-radius: 7.60vh 2.94vh 7.60vh 2.94vh;

        box-shadow:
            #d6faff44 0.25vh 0.25vh 0.49vh 0px inset,
            #25aaff33 -0.25vh -0.25vh 0.74vh 0px inset;
    }

    #wing-hit {
        width: 14.22vh;
        height: 14.22vh;
    }

    #wing-button {
        left: 1.23vh;
        bottom: 1.72vh;

        width: 11.76vh;
        height: 10.29vh;
    }

    #input-scroll {
        left: 18.63vh;
        right: 12.99vh;

        height: 7.35vh;
        margin-top: -3.68vh;
    }

    #input-bar.multiline #input-scroll {
        left: 4.17vh;
        right: 2.45vh;
        top: 2.24vh;

        margin-top: 0px;
    }

    #message-input {
        padding: 0.74vh 0px 0.49vh 0px;

        font-size: 4.17vh;
        line-height: 5.88vh;
    }

    #input-bar.multiline #message-input {
        padding: 0px;
    }

    #send-button {
        right: 2.45vh;
        bottom: 3.55vh;

        width: 7.11vh;
        height: 7.11vh;
    }

}
    </style>
</head>
<body>

<div id="chat-area"></div>

<div id="input-bar">

    <div id="wing-hit"></div>

    <svg id="wing-button"
         viewBox="0 0 54 44"
         xmlns="http://www.w3.org/2000/svg">

        <path
            d="M3 22L14 5H39L51 15L42 39H15L3 22Z"
            fill="#07131E"
            stroke="#5EDFF1"
            stroke-width="1.2"
            stroke-linejoin="round"/>

        <path
            d="M10 22L18 10H36L44 16L37 34H18L10 22Z"
            fill="none"
            stroke="#6ADCF0"
            stroke-opacity=".55"
            stroke-width=".8"/>

        <path
            d="M18 30L31 11L35 15L23 33Z"
            fill="#8BF1FF"
            fill-opacity=".16"
            stroke="#A4F6FF"
            stroke-width="1.1"/>

        <path
            d="M23 29L32 15"
            fill="none"
            stroke="#C0FCFF"
            stroke-width="2"
            stroke-linecap="round"/>

        <path
            d="M7 22H14M40 22H47"
            fill="none"
            stroke="#78E8F8"
            stroke-width="1"
            stroke-linecap="round"/>

    </svg>

    <!-- SCROLL VIEWPORT AROUND TEXTAREA -->
    <div id="input-scroll">
        <textarea id="message-input" rows="1"></textarea>
    </div>

    <div id="send-button">

        <div class="pulse-icon">
            <svg viewBox="0 0 38 38" xmlns="http://www.w3.org/2000/svg">
                <path
                    d="M9 12L13 9V31L9 28Z"
                    fill="#16495C"
                    stroke="#65DFF2"
                    stroke-width=".8"
                    stroke-linejoin="round"/>
                <path
                    d="M18 6L22 4V36L18 34Z"
                    fill="#247B96"
                    stroke="#9CEFFF"
                    stroke-width=".9"
                    stroke-linejoin="round"/>
                <path
                    d="M27 12L31 9V31L27 28Z"
                    fill="#16495C"
                    stroke="#65DFF2"
                    stroke-width=".8"
                    stroke-linejoin="round"/>
                <path
                    d="M13 10L13 30M22 5V35M31 10V30"
                    stroke="#D0FAFF"
                    stroke-opacity=".4"
                    stroke-width=".7"/>
            </svg>
        </div>

        <div class="arrow-icon">
            <svg viewBox="0 0 38 38" xmlns="http://www.w3.org/2000/svg">
                <path
                    d="M6 19.5L33 6L24.5 34L18.5 23L6 19.5Z"
                    fill="#16495C"
                    stroke="#83EDFF"
                    stroke-width="1.5"
                    stroke-linejoin="round"/>
                <path
                    d="M18.5 23L33 6"
                    stroke="#D0FAFF"
                    stroke-width="1.3"
                    stroke-linecap="round"/>
            </svg>
        </div>

    </div>

</div>

</body>
</rml>
