
<rml>
<head>
    <title>Circle Ring</title>

    <style>
        body {
            width: 100%;
            height: 100%;
            margin: 0;

            display: flex;
            align-items: center;
            justify-content: center;
        }

        .layout {
            display: flex;
            flex-direction: column;
            align-items: center;
        }

        .circle-ring {
            width: 100px;
            height: 100px;

            border-width: 6px;
            border-color: #38bdf8;
            border-radius: 56px;
        }

        button {
            margin-top: 24px;
            padding: 10px 18px;
            color: #ffffff;
            background-color: #343a46;
            border-width: 1px;
            border-color: #707987;
            border-radius: 8px;
        }
    </style>
</head>

<body>
    <div class="layout">
        <div class="circle-ring"></div>

        <button data-action="toggle_ring">
            Switch Shape
        </button>
    </div>
</body>
</rml>
