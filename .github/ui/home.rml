
<rml>
<head>
    <title>Obsidian Wing Chat</title>

    <style>

        /* =====================================================
           ROOT
        ===================================================== */

        rml,
        body {
            width: 100%;
            height: 100%;
            margin: 0px;
            padding: 0px;
        }

        body {
            overflow: hidden;
            font-family: "Roboto Flex";
        }


        /* =====================================================
           CHAT AREA
           Only this container scrolls through chat history.
        ===================================================== */

        #chat-area {
            position: absolute;

            left: 6%;
            right: 6%;

            bottom: 26.7vw;
            height: 75%;

            display: block;

            overflow-x: hidden;
            overflow-y: auto;

            overscroll-behavior: contain;

            padding: 2vw 0px;
        }


        /* =====================================================
           CHAT MESSAGE
        ===================================================== */

        .chat-message {
            display: block;

            width: auto;
            max-width: 78%;

            margin-left: auto;
            margin-right: 1.25%;
            margin-bottom: 2.5vw;

            padding: 3vw 4vw;

            border: 1px #65dfff77;
            border-radius: 8vw 3vw 8vw 3vw;

            decorator: linear-gradient(
                125deg,
                #a9f2ff08 0%,
                #0878b51c 27%,
                #061a2b88 52%,
                #5bdcff08 100%
            ) border-box;

            box-shadow:
                #d6faff44 1px 1px 2px 0px inset,
                #25aaff33 -1px -1px 3px 0px inset;

            color: #dffaff;

            font-size: 4.1vw;
            line-height: 1.45;

            white-space: pre-wrap;
        }


        /* =====================================================
           INPUT BAR
        ===================================================== */

        #input-bar {
            position: absolute;
            display: block;

            left: 6%;
            bottom: 9vw;

            width: 15vw;
            height: 15vw;

            border: 1px #65dfff77;
            border-radius: 8vw 3vw 8vw 3vw;

            overflow: hidden;

            decorator: linear-gradient(
                125deg,
                #a9f2ff08 0%,
                #0878b51c 27%,
                #061a2b88 52%,
                #5bdcff08 100%
            ) border-box;

            box-shadow:
                #d6faff44 1px 1px 2px 0px inset,
                #25aaff33 -1px -1px 3px 0px inset;

            transition:
                width 0.8s cubic-out,
                height 0.22s linear-in-out,
                border-radius 0.7s linear-in-out;
        }

        #input-bar.expanded {
            width: 88%;
        }


        /* =====================================================
           WING HIT AREA
        ===================================================== */

        #wing-hit {
            position: absolute;

            left: 0px;
            bottom: 0px;

            width: 15vw;
            height: 15vw;

            z-index: 2;
        }


        /* =====================================================
           WING SVG
        ===================================================== */

        #wing-button {
            position: absolute;

            left: 1.3vw;
            bottom: 1.8vw;

            width: 12.5vw;
            height: 10.2vw;

            pointer-events: none;

            transition:
                left 0.8s cubic-out;
        }

        #input-bar.expanded #wing-button {
            left: 4.2%;
        }


        /* =====================================================
           TEXT INPUT
        ===================================================== */

        #message-input {
            position: absolute;

            left: 19vw;
            right: 14vw;
            top: 50%;

            width: auto;

            height: 7.5vw;
            max-height: 30vw;

            margin-top: -3.75vw;

            padding: 0.8vw 0px 0.5vw 0px;

            font-size: 4.3vw;
            line-height: 6vw;

            color: #dffaff;
            background-color: transparent;

            border-width: 0px;
            border-color: transparent;

            overflow-y: auto;

            caret-color: #65dfff;

            opacity: 0;

            transition:
                opacity 0.25s linear-in-out;
        }

        #input-bar.expanded #message-input {
            opacity: 1;
        }


        /* =====================================================
           SEND BUTTON
        ===================================================== */

        #send-button {
            position: absolute;

            right: 2.5vw;
            bottom: 3.75vw;

            width: 7.5vw;
            height: 7.5vw;

            opacity: 0;
        }

        #input-bar.expanded #send-button {
            opacity: 1;
        }


        /* =====================================================
           PULSE AND ARROW
        ===================================================== */

        .pulse-icon {
            opacity: 1;

            transition:
                opacity 0.2s linear;
        }

        .arrow-icon {
            opacity: 0;

            transition:
                opacity 0.2s linear;
        }

        /* Text entered: hide pulse. */

        #input-bar.has-text .pulse-icon {
            opacity: 0;
        }

        /* Text entered: show arrow. */

        #input-bar.has-text .arrow-icon {
            opacity: 1;
        }


        /* =====================================================
           LANDSCAPE
        ===================================================== */

        @media (orientation: landscape) {

            #chat-area {
                bottom: 26.7vh;
                padding: 2vh 0px;
            }

            .chat-message {
                max-width: 78%;

                margin-right: 1.25%;
                margin-bottom: 2.5vh;

                padding: 3vh 4vh;

                border-radius: 8vh 3vh 8vh 3vh;

                font-size: 4.1vh;
            }

            #input-bar {
                bottom: 9vh;

                width: 15vh;
                height: 15vh;

                border-radius: 8vh 3vh 8vh 3vh;
            }

            #wing-hit {
                width: 15vh;
                height: 15vh;
            }

            #wing-button {
                left: 1.3vh;
                bottom: 1.8vh;

                width: 12.5vh;
                height: 10.2vh;
            }

            #message-input {
                left: 19vh;
                right: 14vh;

                height: 7.5vh;
                max-height: 30vh;

                margin-top: -3.75vh;

                padding: 0.8vh 0px 0.5vh 0px;

                font-size: 4.3vh;
                line-height: 6vh;
            }

            #send-button {
                right: 2.5vh;
                bottom: 3.75vh;

                width: 7.5vh;
                height: 7.5vh;
            }
        }

    </style>
</head>


<body>

    <!-- =====================================================
         CHAT AREA
    ====================================================== -->

    <div id="chat-area"></div>


    <!-- =====================================================
         INPUT BAR
    ====================================================== -->

    <div id="input-bar">


        <!-- WING HIT AREA -->

        <div id="wing-hit"></div>


        <!-- WING SVG -->

        <svg
            id="wing-button"
            viewBox="0 0 54 44"
            xmlns="http://www.w3.org/2000/svg">

            <path
                d="M3 22L14 5H39L51 15L42 39H15L3 22Z"
                fill="#07131E"
                stroke="#5EDFF1"
                stroke-width="1.2"
                stroke-linejoin="round"/>

            <path
                d="M10 22L18 10H36L44 16L37 34H18L10 22Z"
                fill="none"
                stroke="#6ADCF0"
                stroke-opacity=".55"
                stroke-width=".8"/>

            <path
                d="M18 30L31 11L35 15L23 33Z"
                fill="#8BF1FF"
                fill-opacity=".16"
                stroke="#A4F6FF"
                stroke-width="1.1"/>

            <path
                d="M23 29L32 15"
                fill="none"
                stroke="#C0FCFF"
                stroke-width="2"
                stroke-linecap="round"/>

            <path
                d="M7 22H14M40 22H47"
                fill="none"
                stroke="#78E8F8"
                stroke-width="1"
                stroke-linecap="round"/>

        </svg>


        <!-- TEXT INPUT -->

        <textarea
            id="message-input"
            rows="1"></textarea>


        <!-- SEND SVG -->

        <svg
            id="send-button"
            viewBox="0 0 38 38"
            xmlns="http://www.w3.org/2000/svg">


            <!-- ORIGINAL PULSE DESIGN -->

            <g class="pulse-icon">

                <path
                    d="M9 12L13 9V31L9 28Z"
                    fill="#16495C"
                    stroke="#65DFF2"
                    stroke-width=".8"
                    stroke-linejoin="round"/>

                <path
                    d="M18 6L22 4V36L18 34Z"
                    fill="#247B96"
                    stroke="#9CEFFF"
                    stroke-width=".9"
                    stroke-linejoin="round"/>

                <path
                    d="M27 12L31 9V31L27 28Z"
                    fill="#16495C"
                    stroke="#65DFF2"
                    stroke-width=".8"
                    stroke-linejoin="round"/>

                <path
                    d="M13 10L13 30M22 5V35M31 10V30"
                    stroke="#D0FAFF"
                    stroke-opacity=".4"
                    stroke-width=".7"/>

            </g>


            <!-- SEND ARROW -->

            <g class="arrow-icon">

                <path
                    d="M6 19.5L33 6L24.5 34L18.5 23L6 19.5Z"
                    fill="#16495C"
                    stroke="#83EDFF"
                    stroke-width="1.5"
                    stroke-linejoin="round"/>

                <path
                    d="M18.5 23L33 6"
                    stroke="#D0FAFF"
                    stroke-width="1.3"
                    stroke-linecap="round"/>

            </g>

        </svg>

    </div>

</body>
</rml>
