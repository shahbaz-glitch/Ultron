
<rml>
<head>
    <title>Ultron - Outer Ring</title>

    <style>
        body {
            width: 100vw;
            height: 100vh;
            margin: 0;
            padding: 0;
            overflow: hidden;
        }

        #stage {
            display: block;
            position: absolute;
            left: 0;
            top: 0;
            width: 100vw;
            height: 100vh;
        }

        #outer-ring {
            display: block;
            position: absolute;

            /* Circle: 80% of screen width */
            left: 10vw;
            top: 50%;
            margin-top: -40vw;

            width: 80vw;
            height: 80vw;
            box-sizing: border-box;

            background-color: transparent;

            /* One thick, white-cyan ring */
            border: 2.8vw #E8FCFF;
            border-radius: 40vw;

            /* Very subtle cyan glow */
            box-shadow:
                #00D8FF35 0px 0px 7px 1px,
                #00A6CC18 0px 0px 14px 2px;
        }
    </style>
</head>

<body>
    <div id="stage">
        <div id="outer-ring"></div>
    </div>
</body>
</rml>
