<rml>
    <head>
        <title>Ultron Home</title>

        <style>
            body {
                width: 100%;
                height: 100%;
                margin: 0dp;
            }

            #root {
                width: 100%;
                height: 100%;
                display: flex;
                flex-direction: column;
                align-items: center;
                justify-content: center;
                gap: 18dp;
            }

            #show-circle {
                display: block;
                width: 200dp;
                height: 50dp;
                border: 1dp #287F9F;
                border-radius: 10dp;
                background-color: #0D2431;
                color: #D6F7FF;
                font-size: 14dp;
                font-weight: 700;
                text-align: center;
            }

            #show-circle:hover {
                background-color: #16445A;
            }

            #red-circle {
                display: none;
                width: 72dp;
                height: 72dp;
                border-radius: 36dp;
                background-color: #FF304F;
            }

            #red-circle.visible {
                display: block;
            }
        </style>
    </head>

    <body>
        <div id="root">

            <button
                id="show-circle"
                data-action="show-red-circle">
                SHOW RED CIRCLE
            </button>

            <div id="red-circle"></div>

        </div>
    </body>
</rml>
