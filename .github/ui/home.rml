<rml>
    <head>
        <style>

            body {
                width: 100%;
                height: 100%;
                margin: 0dp;
                background-color: transparent;
            }

            #root {
                position: absolute;
                left: 0dp;
                top: 0dp;

                width: 100%;
                height: 100%;

                overflow: hidden;
                clip: always;
            }

            /* Side drawer */

            #drawer {
                position: absolute;

                left: 0dp;
                top: 0dp;

                width: 84%;
                max-width: 360dp;
                height: 100%;

                box-sizing: border-box;

                background-color:
                    rgba(11, 19, 28, 0.97);

                border-right-width: 1dp;
                border-right-color:
                    rgba(55, 178, 215, 0.28);

                border-radius: 0dp 20dp 20dp 0dp;

                transform: translateX(-100%);

                transition:
                    transform 0.28s cubic-out;
            }

            /* Open drawer */

            #drawer.open {
                transform: translateX(0%);
            }

        </style>
    </head>

    <body>

        <div id="root">

            <div id="drawer"></div>

        </div>

    </body>
</rml>
