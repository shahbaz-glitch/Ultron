
<rml>
<head>
    <title>Circle Preview</title>
</head>
<body>
    <svg
        viewBox="0 0 240 240"
        width="240"
        height="240"
        xmlns="http://www.w3.org/2000/svg">

        <circle
            cx="120"
            cy="120"
            r="88"
            fill="none"
            stroke="#60A5FA"
            stroke-width="3" />
    </svg>
</body>
</rml>
