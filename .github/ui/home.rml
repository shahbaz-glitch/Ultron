<rml>
<head>
    <title>J.A.R.V.I.S. First Outer Ring</title>

    <style>
        rml,
        body {
            width: 100%;
            height: 100%;
            margin: 0px;
        }

        body {
            display: flex;
            justify-content: center;
            align-items: center;
            overflow: hidden;
        }

        /* Ring size — unchanged */
        #hud-container {
            position: relative;
            width: 88vw;
            height: 88vw;
            flex-shrink: 0;
            display: flex;
            justify-content: center;
            align-items: center;
            overflow: visible;
        }

        @media (orientation: landscape) {
            #hud-container {
                width: 88vh;
                height: 88vh;
            }
        }

        /* Original cyan-blue glow — unchanged */
        #ring-glow {
            width: 100%;
            height: 100%;
            flex-shrink: 0;

            filter: drop-shadow(#00BFFF 0px 0px 12px);
        }

        #jarvis-ring {
            width: 100%;
            height: 100%;
        }
    </style>
</head>

<body>
    <div id="hud-container">

        <div id="ring-glow">
            <svg
                id="jarvis-ring"
                viewBox="0 0 600 600"
                xmlns="http://www.w3.org/2000/svg">

                <!-- FIRST RING — TESTED, UNCHANGED -->
                <g class="outer-ring-group">

                    <!-- Original outer cyan layer -->
                    <circle
                        cx="300"
                        cy="300"
                        r="270"
                        fill="none"
                        stroke="#00d2ff"
                        stroke-width="14"
                    />

                    <!-- Original cyan rim -->
                    <circle
                        cx="300"
                        cy="300"
                        r="270"
                        fill="none"
                        stroke="#6be6ff"
                        stroke-width="16"
                    />

                    <!-- Original sharp white ring -->
                    <circle
                        cx="300"
                        cy="300"
                        r="270"
                        fill="none"
                        stroke="#ffffff"
                        stroke-width="16"
                    />

                </g>

                <!-- SECOND RING — SAME DESIGN, 18px WHITE STROKE -->
                <g class="second-ring-group">

                    <!-- Inner outer cyan layer -->
                    <circle
                        cx="300"
                        cy="300"
                        r="244"
                        fill="none"
                        stroke="#00d2ff"
                        stroke-width="14"
                    />

                    <!-- Inner cyan rim -->
                    <circle
                        cx="300"
                        cy="300"
                        r="244"
                        fill="none"
                        stroke="#6be6ff"
                        stroke-width="16"
                    />

                    <!-- Inner sharp white ring — 18px -->
                    <circle
                        cx="300"
                        cy="300"
                        r="244"
                        fill="none"
                        stroke="#ffffff"
                        stroke-width="18"
                    />

                </g>

            </svg>
        </div>

    </div>
</body>
</rml>
