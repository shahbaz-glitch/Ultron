
<rml>
<head>
    <title>Obsidian Wing Chat</title>

    <style>

        body {
            width: 100%;
            height: 100%;
            margin: 0px;
            padding: 0px;
            overflow: hidden;
            font-family: "Roboto Flex";
        }

        /* CHAT AREA */

        #chat-area {
            position: absolute;
            left: 6%;
            right: 6%;
            bottom: 27.80vw;
            height: 75%;
            display: block;
            overflow-y: auto;
            padding: 2.12vw 0px;
        }

        /* CHAT BUBBLE */

        .chat-message {
            display: block;
            width: auto;
            max-width: 88%;
            margin-left: auto;
            margin-bottom: 2.65vw;
            padding: 3.18vw 4.23vw;

            border: 0.30vw #65dfff99;
            border-radius: 8.21vw 3.18vw 8.21vw 3.18vw;

            decorator: linear-gradient(
                125deg,
                #a9f2ff08 0%,
                #0878b51c 27%,
                #061a2b88 52%,
                #5bdcff08 100%
            ) border-box;

            box-shadow:
                #d6faff44 0px 0px 0.38vw 0px inset,
                #d6faff66 0.27vw 0.27vw 0.70vw 0px inset,
                #25aaff55 -0.27vw -0.27vw 1.05vw 0px inset;

            color: #dffaff;
            font-size: 4.23vw;
            line-height: 1.45;
            white-space: pre-wrap;
        }

        /* INPUT BAR */

        #input-bar {
            position: absolute;
            display: block;

            left: 6%;
            bottom: 7.94vw;

            width: 15.36vw;
            height: 15.36vw;

            border: 0.30vw #65dfff99;
            border-radius: 8.21vw 3.18vw 8.21vw 3.18vw;

            overflow: hidden;

            decorator: linear-gradient(
                125deg,
                #a9f2ff08 0%,
                #0878b51c 27%,
                #061a2b88 52%,
                #5bdcff08 100%
            ) border-box;

            box-shadow:
                #d6faff44 0px 0px 0.38vw 0px inset,
                #d6faff66 0.27vw 0.27vw 0.70vw 0px inset,
                #25aaff55 -0.27vw -0.27vw 1.05vw 0px inset;

            transition:
                width 0.8s cubic-out,
                border-radius 0.7s linear-in-out;
        }

        #input-bar.expanded {
            width: 88%;
        }

        /* MULTILINE INPUT BAR */

        #input-bar.multiline {
            /* Height controlled by UpdateInput(). */
        }

        /* WING HIT AREA */

        #wing-hit {
            position: absolute;
            left: 0px;
            bottom: 0px;

            width: 15.36vw;
            height: 15.36vw;

            z-index: 2;
        }

        /* WING DESIGN */

        #wing-button {
            position: absolute;
            left: 1.33vw;
            bottom: 1.86vw;

            width: 12.70vw;
            height: 11.11vw;

            pointer-events: none;

            transition: left 0.8s cubic-out;
        }

        #input-bar.expanded #wing-button {
            left: 4.2%;
        }

        /* MESSAGE INPUT */

        #message-input {
            position: absolute;

            left: 20.12vw;
            right: 14.03vw;
            top: 50%;

            width: auto;
            height: 7.94vw;
            max-height: 31.23vw;

            margin-top: -3.97vw;
            padding: 0.80vw 0px 0.53vw 0px;

            font-size: 4.50vw;
            line-height: 6.35vw;

            color: #dffaff;
            background-color: transparent;

            border-width: 0px;
            border-color: transparent;

            overflow-y: auto;

            caret-color: #65dfff;

            opacity: 0;

            transition: opacity 0.15s linear-in-out;
        }

        #input-bar.expanded #message-input {
            opacity: 1;
        }

        /*
            FIRST LINE SHIFT

            First line starts after the wing.

            Once wrapping begins, the textarea
            moves upward and uses full available width.
        */

        #input-bar.multiline #message-input {
            left: 4.50vw;
            right: 2.65vw;
            top: 0px;

            width: auto;
            margin-top: 0px;

            padding: 0.80vw 0px 0.53vw 0px;
        }

        /* SEND BUTTON */

        #send-button {
            position: absolute;

            display: none;

            right: 2.65vw;
            bottom: 3.83vw;

            width: 7.68vw;
            height: 7.68vw;

            opacity: 0;
        }

        #input-bar.expanded #send-button {
            display: block;
            opacity: 1;
        }

        /* PULSE AND ARROW WRAPPERS */

        #send-button .pulse-icon,
        #send-button .arrow-icon {
            position: absolute;

            left: 0px;
            top: 0px;

            width: 100%;
            height: 100%;

            transition: opacity 0.15s linear-in-out;
        }

        #send-button .pulse-icon svg,
        #send-button .arrow-icon svg {
            width: 100%;
            height: 100%;
            display: block;
        }

        .pulse-icon {
            opacity: 1;
        }

        .arrow-icon {
            opacity: 0;
        }

        #input-bar.has-text .pulse-icon {
            opacity: 0;
        }

        #input-bar.has-text .arrow-icon {
            opacity: 1;
        }


        /* LANDSCAPE RESPONSIVE SCALING */

        @media (orientation: landscape) {

            /* CHAT AREA */

            #chat-area {
                bottom: 27.80vh;
                padding: 2.12vh 0px;
            }

            /* CHAT BUBBLE */

            .chat-message {
                margin-bottom: 2.65vh;
                padding: 3.18vh 4.23vh;

                border: 0.30vh #65dfff99;
                border-radius: 8.21vh 3.18vh 8.21vh 3.18vh;

                box-shadow:
                    #d6faff44 0px 0px 0.38vh 0px inset,
                    #d6faff66 0.27vh 0.27vh 0.70vh 0px inset,
                    #25aaff55 -0.27vh -0.27vh 1.05vh 0px inset;

                font-size: 4.23vh;
            }

            /* INPUT BAR */

            #input-bar {
                bottom: 7.94vh;

                width: 15.36vh;
                height: 15.36vh;

                border: 0.30vh #65dfff99;
                border-radius: 8.21vh 3.18vh 8.21vh 3.18vh;

                box-shadow:
                    #d6faff44 0px 0px 0.38vh 0px inset,
                    #d6faff66 0.27vh 0.27vh 0.70vh 0px inset,
                    #25aaff55 -0.27vh -0.27vh 1.05vh 0px inset;
            }

            /* WING HIT AREA */

            #wing-hit {
                width: 15.36vh;
                height: 15.36vh;
            }

            /* WING DESIGN */

            #wing-button {
                left: 1.33vh;
                bottom: 1.86vh;

                width: 12.70vh;
                height: 11.11vh;
            }

            /* MESSAGE INPUT */

            #message-input {
                left: 20.12vh;
                right: 14.03vh;

                height: 7.94vh;
                max-height: 31.23vh;

                margin-top: -3.97vh;
                padding: 0.80vh 0px 0.53vh 0px;

                font-size: 4.50vh;
                line-height: 6.35vh;
            }

            /* MULTILINE INPUT */

            #input-bar.multiline #message-input {
                left: 4.50vh;
                right: 2.65vh;
                top: 0px;

                margin-top: 0px;
                padding: 0.80vh 0px 0.53vh 0px;
            }

            /* SEND BUTTON */

            #send-button {
                right: 2.65vh;
                bottom: 3.83vh;

                width: 7.68vh;
                height: 7.68vh;
            }

        }

    </style>

</head>

<body>

    <!-- CHAT AREA -->

    <div id="chat-area"></div>

    <!-- INPUT BAR -->

    <div id="input-bar">

        <!-- WING HIT AREA -->

        <div id="wing-hit"></div>

        <!-- WING SVG -->

        <svg id="wing-button"
             viewBox="0 0 54 44"
             xmlns="http://www.w3.org/2000/svg">

            <path
                d="M3 22L14 5H39L51 15L42 39H15L3 22Z"
                fill="#07131E"
                stroke="#5EDFF1"
                stroke-width="1.2"
                stroke-linejoin="round"/>

            <path
                d="M10 22L18 10H36L44 16L37 34H18L10 22Z"
                fill="none"
                stroke="#6ADCF0"
                stroke-opacity=".55"
                stroke-width=".8"/>

            <path
                d="M18 30L31 11L35 15L23 33Z"
                fill="#8BF1FF"
                fill-opacity=".16"
                stroke="#A4F6FF"
                stroke-width="1.1"/>

            <path
                d="M23 29L32 15"
                fill="none"
                stroke="#C0FCFF"
                stroke-width="2"
                stroke-linecap="round"/>

            <path
                d="M7 22H14M40 22H47"
                fill="none"
                stroke="#78E8F8"
                stroke-width="1"
                stroke-linecap="round"/>

        </svg>

        <!-- TEXT INPUT -->

        <textarea id="message-input" rows="1"></textarea>

        <!-- SEND BUTTON CONTAINER -->

        <div id="send-button">

            <!-- PULSE ICON -->

            <div class="pulse-icon">

                <svg
                    viewBox="0 0 38 38"
                    xmlns="http://www.w3.org/2000/svg">

                    <path
                        d="M9 12L13 9V31L9 28Z"
                        fill="#16495C"
                        stroke="#65DFF2"
                        stroke-width=".8"
                        stroke-linejoin="round"/>

                    <path
                        d="M18 6L22 4V36L18 34Z"
                        fill="#247B96"
                        stroke="#9CEFFF"
                        stroke-width=".9"
                        stroke-linejoin="round"/>

                    <path
                        d="M27 12L31 9V31L27 28Z"
                        fill="#16495C"
                        stroke="#65DFF2"
                        stroke-width=".8"
                        stroke-linejoin="round"/>

                    <path
                        d="M13 10L13 30M22 5V35M31 10V30"
                        stroke="#D0FAFF"
                        stroke-opacity=".4"
                        stroke-width=".7"/>

                </svg>

            </div>

            <!-- ARROW ICON -->

            <div class="arrow-icon">

                <svg
                    viewBox="0 0 38 38"
                    xmlns="http://www.w3.org/2000/svg">

                    <path
                        d="M6 19.5L33 6L24.5 34L18.5 23L6 19.5Z"
                        fill="#16495C"
                        stroke="#83EDFF"
                        stroke-width="1.5"
                        stroke-linejoin="round"/>

                    <path
                        d="M18.5 23L33 6"
                        stroke="#D0FAFF"
                        stroke-width="1.3"
                        stroke-linecap="round"/>

                </svg>

            </div>

        </div>

    </div>


    <!-- CHAT INPUT LOGIC -->

    <script>

        var inputBar = document.GetElementById("input-bar");
        var wingHit = document.GetElementById("wing-hit");
        var messageInput = document.GetElementById("message-input");
        var sendButton = document.GetElementById("send-button");
        var chatArea = document.GetElementById("chat-area");

        var editingBubble = null;

        /*
            FIRST LINE STATE

            Once the first line shifts upward,
            it stays shifted until input is cleared.
        */

        var firstLineShifted = false;


        /* OPEN / CLOSE INPUT BAR */

        wingHit.AddEventListener("click", function() {

            if (inputBar.GetClassList().Contains("expanded")) {

                inputBar.GetClassList().Remove("expanded");

            } else {

                inputBar.GetClassList().Add("expanded");

                messageInput.focus();

            }

        });


        /* INPUT HEIGHT AND TEXT POSITION */

        function UpdateInput() {

            var message = messageInput.value;

            /*
                RESPONSIVE CONTROL HEIGHT

                Gets the actual rendered wing area
                in portrait or landscape.
            */

            var controlHeight = wingHit.offsetHeight;

            /*
                Responsive vertical padding.

                Top + bottom = 1.33vw / vh.
            */

            var paddingHeight =
                controlHeight * (1.33 / 15.36);

            /*
                Responsive maximum text height.
            */

            var maxTextHeight =
                controlHeight * (32.56 / 15.36);

            var barHeight = controlHeight;


            /* EMPTY INPUT */

            if (message.length == 0) {

                firstLineShifted = false;

                inputBar.GetClassList().Remove("multiline");

                messageInput.style.height = "";

            }

            else {

                /*
                    FIRST LINE DETECTION

                    Compare actual content height
                    against the visible one-line area.
                */

                if (!firstLineShifted) {

                    if (
                        messageInput.scrollHeight >
                        messageInput.clientHeight + 1
                    ) {

                        firstLineShifted = true;

                        inputBar.GetClassList().Add("multiline");

                    }

                }


                /*
                    MULTILINE INPUT

                    Textarea moves upward and uses
                    full available width.
                */

                if (firstLineShifted) {

                    messageInput.style.height = "0px";

                    var contentHeight =
                        messageInput.scrollHeight;

                    var newHeight = Math.min(
                        contentHeight,
                        maxTextHeight
                    );

                    messageInput.style.height =
                        Math.max(
                            0,
                            newHeight - paddingHeight
                        ) + "px";

                    /*
                        Text area + bottom control area.
                    */

                    barHeight =
                        newHeight + controlHeight;

                }

                else {

                    messageInput.style.height = "";

                    barHeight = controlHeight;

                }

            }


            /* INPUT BAR HEIGHT */

            inputBar.style.height =
                barHeight + "px";


            /*
                CHAT AREA POSITION

                Original spacing is scaled
                proportionally with the control.
            */

            chatArea.style.bottom =
                (
                    barHeight +
                    controlHeight * (12.44 / 15.36)
                ) + "px";


            /* PULSE / ARROW STATE */

            if (message.trim().length > 0) {

                inputBar.GetClassList().Add("has-text");

            } else {

                inputBar.GetClassList().Remove("has-text");

            }

        }


        /* INPUT EVENT */

        messageInput.AddEventListener("input", function() {

            UpdateInput();

        });


        /* LONG PRESS EDIT */

        function StartEdit(bubble) {

            if (!bubble || !bubble.parentNode) {
                return;
            }

            var next = bubble.nextElementSibling;

            while (next) {

                var following = next.nextElementSibling;

                next.remove();

                next = following;

            }

            editingBubble = bubble;

            messageInput.value = bubble.textContent;

            bubble.remove();

            firstLineShifted = false;

            inputBar.GetClassList().Add("expanded");

            UpdateInput();

            messageInput.focus();

        }


        /* LONG PRESS DETECTION */

        function AttachLongPress(bubble) {

            var pressTimer = null;

            bubble.AddEventListener("pointerdown", function(event) {

                if (event.pointerType == "mouse" && event.button != 0) {
                    return;
                }

                if (pressTimer != null) {

                    clearTimeout(pressTimer);

                }

                pressTimer = setTimeout(function() {

                    StartEdit(bubble);

                    pressTimer = null;

                }, 550);

            });


            function CancelPress() {

                if (pressTimer != null) {

                    clearTimeout(pressTimer);

                    pressTimer = null;

                }

            }


            bubble.AddEventListener("pointerup", CancelPress);

            bubble.AddEventListener("pointercancel", CancelPress);

            bubble.AddEventListener("pointerleave", CancelPress);


            bubble.AddEventListener("contextmenu", function(event) {

                event.preventDefault();

            });

        }


        /* SEND MESSAGE */

        function SendMessage() {

            var message = messageInput.value.trim();

            if (message.length == 0) {
                return;
            }


            if (editingBubble != null) {

                editingBubble.textContent = message;

                chatArea.AppendChild(editingBubble);

                editingBubble = null;

            }

            else {

                var bubble = document.CreateElement("div");

                bubble.SetClass("chat-message");

                bubble.textContent = message;

                AttachLongPress(bubble);

                chatArea.AppendChild(bubble);

            }


            chatArea.scrollTop = chatArea.scrollHeight;

            messageInput.value = "";

            firstLineShifted = false;

            UpdateInput();

        }


        /* SEND BUTTON */

        sendButton.AddEventListener("click", function() {

            SendMessage();

        });


        /*
            ENTER BEHAVIOUR

            Enter creates a new line.

            No Enter-to-send handler.

            The arrow button sends the message.
        */


        /* INITIAL CHAT POSITION */

        UpdateInput();

    </script>

</body>
</rml>
