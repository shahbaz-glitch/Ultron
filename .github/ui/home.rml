<rml>
    <head>
        <title>Jarvis HUD Border</title>

        <style>
            body {
                width: 100%;
                height: 100%;
                margin: 0;
                padding: 0;
                overflow: hidden;
            }

            #hud-border {
                position: absolute;
                left: 0;
                top: 0;
                width: 100%;
                height: 100%;
            }
        </style>
    </head>

    <body>
        <svg id="hud-border"
             viewBox="0 0 420 900"
             preserveAspectRatio="none"
             xmlns="http://www.w3.org/2000/svg">

            <defs>
                <filter id="cyan-glow"
                        x="-20%" y="-10%"
                        width="140%" height="120%">
                    <feGaussianBlur stdDeviation="2.5"/>
                </filter>
            </defs>

            <!-- Soft cyan glow -->
            <path
                d="M16 54 L29 41 H151 L163 51 H257
                   L269 41 H391 L404 54 V858
                   L391 871 H29 L16 858 Z"
                fill="none"
                stroke="#00DFFF"
                stroke-width="6"
                opacity="0.28"
                filter="url(#cyan-glow)"/>

            <!-- Sharp neon outline -->
            <path
                d="M16 54 L29 41 H151 L163 51 H257
                   L269 41 H391 L404 54 V858
                   L391 871 H29 L16 858 Z"
                fill="none"
                stroke="#00DFFF"
                stroke-width="2.6"
                stroke-linejoin="round"/>
        </svg>
    </body>
</rml>
