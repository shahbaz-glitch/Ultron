
<rml>
<head>
    <title>Square Ring Test</title>

    <style>
        body {
            width: 100%;
            height: 100%;
            margin: 0;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .square-ring {
            width: 120px;
            height: 120px;
            border-width: 8px;
            border-color: #ff7ac8;
            border-radius: 22px;
        }
    </style>
</head>

<body>
    <div class="square-ring"></div>
</body>
</rml>
