
<rml>
<head>
    <style>
        body {
            margin: 0px;
            padding: 24px;
            background-color: #000000;
            color: #ffffff;
            font-family: "Roboto Flex";
            font-size: 28px;
            font-weight: 400;
        }

        button {
            margin-bottom: 20px;
            padding: 10px;
        }
    </style>
</head>

<body id="font-sample">
    <button data-action="toggle_font">SWITCH FONT</button>

    <div>ROBOTO FLEX</div>
    <div>Font Loading Test</div>
    <div>ABCDEFGHIJKLMNOPQRSTUVWXYZ</div>
    <div>0123456789</div>
</body>
</rml>
