
<rml>
<head>
    <title>Ultron - Outer Ring</title>

    <style>
        body {
            width: 100vw;
            height: 100vh;
            margin: 0;
            padding: 0;
            overflow: hidden;
        }

        #stage {
            position: absolute;
            left: 0;
            top: 0;
            width: 100vw;
            height: 100vh;
        }

        #outer-ring {
            position: absolute;

            left: 50%;
            top: 50%;

            width: 80vw;
            height: 80vw;

            min-width: 80vw;
            max-width: 80vw;
            min-height: 80vw;
            max-height: 80vw;

            box-sizing: border-box;
            background-color: transparent;

            /* Original bright white-cyan ring */
            border: 1.8vw #E8FCFF;
            border-radius: 40vw;

            /* Very subtle cyan glow */
            box-shadow:
                #00D8FF30 0px 0px 7px 1px,
                #00A6CC18 0px 0px 12px 1px;

            /* Centre using the element's own dimensions */
            transform: translate(-50%, -50%);
        }
    </style>
</head>

<body>
    <div id="stage">
        <div id="outer-ring"></div>
    </div>
</body>
</rml>
