<rml>
    <head>
        <title>JARVIS Outer Ring</title>

        <style>
            #outer-ring {
                display: block;
                width: 600px;
                height: 600px;
            }
        </style>
    </head>

    <body>
        <svg
            id="outer-ring"
            width="600"
            height="600"
            viewBox="0 0 600 600"
            xmlns="http://www.w3.org/2000/svg">

            <defs>
                <radialGradient
                    id="ambient-cyan"
                    cx="300"
                    cy="300"
                    r="270"
                    gradientUnits="userSpaceOnUse">

                    <stop offset="0%"
                          stop-color="#020608"
                          stop-opacity="0"/>

                    <stop offset="76%"
                          stop-color="#020608"
                          stop-opacity="0"/>

                    <stop offset="80%"
                          stop-color="#00DFFF"
                          stop-opacity="0.015"/>

                    <stop offset="83%"
                          stop-color="#00DFFF"
                          stop-opacity="0.06"/>

                    <stop offset="86%"
                          stop-color="#00DFFF"
                          stop-opacity="0.19"/>

                    <stop offset="88%"
                          stop-color="#00DFFF"
                          stop-opacity="0.25"/>

                    <stop offset="91%"
                          stop-color="#00DFFF"
                          stop-opacity="0.13"/>

                    <stop offset="95%"
                          stop-color="#00DFFF"
                          stop-opacity="0.035"/>

                    <stop offset="100%"
                          stop-color="#00DFFF"
                          stop-opacity="0"/>
                </radialGradient>
            </defs>

            <!-- Soft cyan ambient glow -->
            <circle
                cx="300"
                cy="300"
                r="270"
                fill="url(#ambient-cyan)"/>

            <!-- Main thin ring -->
            <circle
                cx="300"
                cy="300"
                r="235"
                fill="none"
                stroke="#EAFBFF"
                stroke-width="14"/>
        </svg>
    </body>
</rml>
