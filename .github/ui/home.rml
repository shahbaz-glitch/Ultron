<rml>
    <head>
        <title>Jarvis HUD Border</title>

        <style>
            body {
                width: 100%;
                height: 100%;
                margin: 0;
                padding: 0;
                overflow: hidden;
            }

            #hud-border {
                position: absolute;
                left: 0;
                top: 0;
                width: 100%;
                height: 100%;
            }
        </style>
    </head>

    <body>
        <svg id="hud-border"
             viewBox="0 0 420 900"
             preserveAspectRatio="none"
             xmlns="http://www.w3.org/2000/svg">

            <defs>
                <filter id="cyan-glow"
                        x="-20%"
                        y="-10%"
                        width="140%"
                        height="120%">
                    <feGaussianBlur stdDeviation="2.5"/>
                </filter>
            </defs>

            <!-- Soft cyan glow -->
            <path
                d="M5 83
                   L19 69
                   H151
                   L163 79
                   H257
                   L269 69
                   H401
                   L415 83
                   V885
                   L402 898
                   H18
                   L5 885 Z"
                fill="none"
                stroke="#00DFFF"
                stroke-width="6"
                opacity="0.28"
                filter="url(#cyan-glow)"/>

            <!-- Sharp neon outline -->
            <path
                d="M5 83
                   L19 69
                   H151
                   L163 79
                   H257
                   L269 69
                   H401
                   L415 83
                   V885
                   L402 898
                   H18
                   L5 885 Z"
                fill="none"
                stroke="#00DFFF"
                stroke-width="2.6"
                stroke-linejoin="round"/>
        </svg>
    </body>
</rml>
