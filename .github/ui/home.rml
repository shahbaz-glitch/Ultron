
<rml>
<head>
    <title>Circle Demo</title>

    <style>
        body {
            background-color: #20242b;
            padding: 30px;
        }

        .circle {
            width: 100px;
            height: 100px;
            background-color: #2878ff;
            border-radius: 50%;
            margin-bottom: 20px;
        }

        .outline-circle {
            width: 100px;
            height: 100px;
            background-color: transparent;
            border: 4px solid #22c55e;
            border-radius: 50%;
        }
    </style>
</head>

<body>
    <div class="circle"></div>
    <div class="outline-circle"></div>
</body>
</rml>
