
<rml>
<head>
    <title>Ultron Home</title>

    <style>
        body {
            width: 100%;
            height: 100%;
            margin: 0;

            font-family: "Roboto Flex";
        }

        #toggle-button {
            position: absolute;

            left: 20%;
            top: 82%;

            width: 60%;
            height: 9%;

            display: flex;
            align-items: center;
            justify-content: center;

            background-color: #102C3A;

            border-width: 1px;
            border-color: #28BDE8;
            border-radius: 10px;

            color: #E5F9FF;
            font-size: 14px;
            font-weight: 700;
            text-align: center;
        }

        #red-circle {
            position: absolute;

            left: 50%;
            top: 50%;

            width: 120px;
            height: 120px;

            margin-left: -60px;
            margin-top: -60px;

            background-color: #FF2020;

            border-radius: 60px;

            display: none;
        }
    </style>
</head>

<body>

    <button id="toggle-button">
        DOUBLE TAP
    </button>

    <div id="red-circle"></div>

</body>
</rml>
