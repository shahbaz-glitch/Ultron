<rml>
<head>
    <title>Circle Demo</title>

    <style>
        body {
            display: block;
            position: absolute;
            top: 0px;
            right: 0px;
            bottom: 0px;
            left: 0px;

            box-sizing: border-box;
            background-color: #20242b;
            padding: 30px;
        }

        div {
            display: block;
        }

        .circle {
            width: 100px;
            height: 100px;
            background-color: #2878ff;
            border-radius: 50px;
            margin-bottom: 20px;
        }

        .outline-circle {
            box-sizing: border-box;
            width: 100px;
            height: 100px;
            background-color: transparent;
            border: 4px #22c55e;
            border-radius: 50px;
        }
    </style>
</head>

<body>
    <div class="circle"></div>
    <div class="outline-circle"></div>
</body>
</rml>
