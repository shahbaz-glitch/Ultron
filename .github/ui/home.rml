<rml>
    <head>
        <style>

            body {
                width: 100%;
                height: 100%;
                margin: 0dp;
                background-color: transparent;
            }

            #root {
                position: absolute;

                left: 0dp;
                top: 0dp;

                width: 100%;
                height: 100%;

                overflow: hidden;
                clip: always;
            }

            /* ----------------------------------------
               Blue side drawer
            ---------------------------------------- */

            #drawer {
                position: absolute;

                left: 0dp;
                top: 0dp;

                width: 84%;
                height: 100%;

                box-sizing: border-box;

                background-color: #087BDF;

                border-top-right-radius: 18dp;
                border-bottom-right-radius: 18dp;

                transform: translateX(-100%);

                transition:
                    transform 0.30s cubic-out;
            }

            /* ----------------------------------------
               Drawer open
            ---------------------------------------- */

            #drawer.open {
                transform: translateX(0%);
            }

        </style>
    </head>

    <body>

        <div id="root">

            <div id="drawer"></div>

        </div>

    </body>
</rml>
