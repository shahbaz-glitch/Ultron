<rml>
<head>
    <title>J.A.R.V.I.S. First Outer Ring</title>

    <style>
        rml,
        body {
            width: 100%;
            height: 100%;
            margin: 0px;
        }

        body {
            display: flex;
            justify-content: center;
            align-items: center;
            overflow: hidden;
        }

        /* Ring size — unchanged */
        #hud-container {
            position: relative;
            width: 88vw;
            height: 88vw;
            flex-shrink: 0;
            display: flex;
            justify-content: center;
            align-items: center;
            overflow: visible;
        }

        @media (orientation: landscape) {
            #hud-container {
                width: 88vh;
                height: 88vh;
            }
        }

        /* FIRST LAYER — glow only for rings 1 and 2 */
        #ring-glow {
            position: absolute;
            top: 0px;
            left: 0px;
            width: 100%;
            height: 100%;
            flex-shrink: 0;

            filter: drop-shadow(#00BFFF 0px 0px 12px);
        }

        /* SECOND LAYER — no shadow for rings 3, 4 and 5 */
        #detail-rings {
            position: absolute;
            top: 0px;
            left: 0px;
            width: 100%;
            height: 100%;
            flex-shrink: 0;
        }

        #jarvis-ring,
        #jarvis-detail-rings {
            width: 100%;
            height: 100%;
        }

        /* ADDED — CENTER J.A.R.V.I.S. VECTOR WORDMARK */
        #jarvis-wordmark {
            position: absolute;
            top: 0px;
            left: 0px;
            width: 100%;
            height: 100%;
            z-index: 10;
        }

        #jarvis-wordmark-svg {
            display: block;
            width: 100%;
            height: 100%;
        }
    </style>
</head>

<body>
    <div id="hud-container">

        <!-- GLOW LAYER: FIRST AND SECOND RINGS ONLY -->
        <div id="ring-glow">
            <svg
                id="jarvis-ring"
                viewBox="0 0 600 600"
                xmlns="http://www.w3.org/2000/svg">

                <!-- FIRST RING — UNCHANGED -->
                <g class="outer-ring-group">

                    <!-- Continuous cyan base -->
                    <circle
                        cx="300"
                        cy="300"
                        r="270"
                        fill="none"
                        stroke="#00d2ff"
                        stroke-width="14"
                    />

                    <!-- Cyan rim — four arcs -->
                    <g
                        fill="none"
                        stroke="#6be6ff"
                        stroke-width="16"
                        stroke-linecap="butt">

                        <path
                            d="M 569.9833 302.9999
                               A 270 270 0 0 1 302.9999 569.9833"
                        />

                        <path
                            d="M 297.0001 569.9833
                               A 270 270 0 0 1 30.0167 302.9999"
                        />

                        <path
                            d="M 30.0167 297.0001
                               A 270 270 0 0 1 297.0001 30.0167"
                        />

                        <path
                            d="M 302.9999 30.0167
                               A 270 270 0 0 1 569.9833 297.0001"
                        />

                    </g>

                    <!-- White ring — same four cuts -->
                    <g
                        fill="none"
                        stroke="#ffffff"
                        stroke-width="16"
                        stroke-linecap="butt">

                        <path
                            d="M 569.9833 302.9999
                               A 270 270 0 0 1 302.9999 569.9833"
                        />

                        <path
                            d="M 297.0001 569.9833
                               A 270 270 0 0 1 30.0167 302.9999"
                        />

                        <path
                            d="M 30.0167 297.0001
                               A 270 270 0 0 1 297.0001 30.0167"
                        />

                        <path
                            d="M 302.9999 30.0167
                               A 270 270 0 0 1 569.9833 297.0001"
                        />

                    </g>

                </g>

                <!-- SECOND RING — UNCHANGED -->
                <g class="second-ring-group">

                    <circle
                        cx="300"
                        cy="300"
                        r="244"
                        fill="none"
                        stroke="#00d2ff"
                        stroke-width="14"
                    />

                    <circle
                        cx="300"
                        cy="300"
                        r="244"
                        fill="none"
                        stroke="#6be6ff"
                        stroke-width="16"
                    />

                    <circle
                        cx="300"
                        cy="300"
                        r="244"
                        fill="none"
                        stroke="#ffffff"
                        stroke-width="18"
                    />

                </g>

            </svg>
        </div>

        <!-- NO-GLOW LAYER: THIRD, FOURTH AND FIFTH RINGS -->
        <div id="detail-rings">
            <svg
                id="jarvis-detail-rings"
                viewBox="0 0 600 600"
                xmlns="http://www.w3.org/2000/svg">

                <!-- THIRD RING — 12 SVG UNITS FROM SECOND RING -->
                <g
                    class="third-ring-group"
                    fill="none"
                    stroke="#00dfff"
                    stroke-width="2.5"
                    stroke-linecap="butt">

                    <path
                        d="M 521.6818 305.5000
                           A 221.75 221.75 0 0 1 193.9222 494.7321"
                    />

                    <path
                        d="M 184.3960 489.2321
                           A 221.75 221.75 0 0 1 184.3960 110.7679"
                    />

                    <path
                        d="M 193.9222 105.2679
                           A 221.75 221.75 0 0 1 521.6818 294.5000"
                    />

                </g>

                <!-- THIRD RING — WHITE ENDPOINT DOT PAIRS -->
                <g
                    class="third-ring-dots"
                    fill="#ffffff">

                    <circle cx="521.6818" cy="305.5000" r="4.5"/>
                    <circle cx="521.6818" cy="294.5000" r="4.5"/>

                    <circle cx="193.9222" cy="494.7321" r="4.5"/>
                    <circle cx="184.3960" cy="489.2321" r="4.5"/>

                    <circle cx="184.3960" cy="110.7679" r="4.5"/>
                    <circle cx="193.9222" cy="105.2679" r="4.5"/>

                </g>

                <!-- FOURTH RING — THIN SEGMENTS -->
                <g
                    class="fourth-ring-thin-segments"
                    fill="none"
                    stroke="#00dfff"
                    stroke-width="2.5"
                    stroke-linecap="butt">

                    <path
                        d="M 478.5838 397.0484
                           A 203.25 203.25 0 0 1 294.7546 503.1823"
                    />

                    <path
                        d="M 126.6617 406.1339
                           A 203.25 203.25 0 0 1 126.6617 193.8661"
                    />

                    <path
                        d="M 294.7546 96.8177
                           A 203.25 203.25 0 0 1 478.5838 202.9516"
                    />

                </g>

                <!-- FOURTH RING — ADDED ARCS, THIN PORTIONS -->
                <g
                    class="fourth-ring-added-arcs"
                    fill="none"
                    stroke="#00cfff"
                    stroke-width="4.5"
                    stroke-linecap="butt">

                    <path
                        d="M 482.2646 210.0545
                           A 203.25 203.25 0 0 1 482.2646 389.9455"
                    />

                    <path
                        d="M 286.7628 502.8185
                           A 203.25 203.25 0 0 1 130.9726 412.8730"
                    />

                    <path
                        d="M 130.9726 187.1270
                           A 203.25 203.25 0 0 1 286.7628 97.1815"
                    />

                </g>

                <!-- FOURTH RING — THICK PORTIONS, 9 SVG UNITS -->
                <g
                    class="fourth-ring-thick-portions"
                    fill="none"
                    stroke="#00cfff"
                    stroke-width="9"
                    stroke-linecap="butt">

                    <path
                        d="M 503.25 300
                           A 203.25 203.25 0 0 1 482.2646 389.9455"
                    />

                    <path
                        d="M 286.7628 502.8185
                           A 203.25 203.25 0 0 1 198.3750 476.0197"
                    />

                    <path
                        d="M 130.9726 187.1270
                           A 203.25 203.25 0 0 1 198.3750 123.9803"
                    />

                </g>

                <!-- FIFTH RING — THREE EQUAL SEGMENTS -->
                <!-- Radius: 179.5 SVG units -->
                <!-- Thin cyan stroke: 2.5 SVG units -->
                <!-- No dots and no added shadow -->
                <g
                    class="fifth-ring-group"
                    fill="none"
                    stroke="#00dfff"
                    stroke-width="2.5"
                    stroke-linecap="butt">

                    <path
                        d="M 468.6748 361.3926
                           A 179.5 179.5 0 0 1 268.8301 476.7730"
                    />

                    <path
                        d="M 162.4950 415.3804
                           A 179.5 179.5 0 0 1 162.4950 184.6196"
                    />

                    <path
                        d="M 268.8301 123.2270
                           A 179.5 179.5 0 0 1 468.6748 238.6074"
                    />

                </g>

                <!-- FIFTH RING — RADIAL TICK BARS -->
                <g
                    class="fifth-ring-radial-ticks"
                    fill="none"
                    stroke="#00dfff"
                    stroke-linecap="butt">

                    <!-- TICK CLUSTER 1 -->
                    <g transform="rotate(0 300 300)">

                        <!-- Regular tick bars -->
                        <g stroke-width="3.5">

                            <line x1="470" y1="300" x2="480" y2="300"
                                  transform="rotate(-13.5 300 300)"/>

                            <line x1="470" y1="300" x2="480" y2="300"
                                  transform="rotate(0 300 300)"/>

                            <line x1="470" y1="300" x2="480" y2="300"
                                  transform="rotate(13.5 300 300)"/>

                        </g>

                        <!-- Slightly larger tick bars -->
                        <g stroke-width="3.8">

                            <line x1="469.5" y1="300" x2="481" y2="300"
                                  transform="rotate(-9 300 300)"/>

                            <line x1="469.5" y1="300" x2="481" y2="300"
                                  transform="rotate(9 300 300)"/>

                        </g>

                        <!-- Two central, slightly longer bars -->
                        <g stroke-width="3.5">

                            <line x1="470" y1="300" x2="482" y2="300"
                                  transform="rotate(-4.5 300 300)"/>

                            <line x1="470" y1="300" x2="482" y2="300"
                                  transform="rotate(4.5 300 300)"/>

                        </g>

                    </g>

                    <!-- TICK CLUSTER 2 — rotated 120 degrees -->
                    <g transform="rotate(120 300 300)">

                        <g stroke-width="3.5">

                            <line x1="470" y1="300" x2="480" y2="300"
                                  transform="rotate(-13.5 300 300)"/>

                            <line x1="470" y1="300" x2="480" y2="300"
                                  transform="rotate(0 300 300)"/>

                            <line x1="470" y1="300" x2="480" y2="300"
                                  transform="rotate(13.5 300 300)"/>

                        </g>

                        <g stroke-width="3.8">

                            <line x1="469.5" y1="300" x2="481" y2="300"
                                  transform="rotate(-9 300 300)"/>

                            <line x1="469.5" y1="300" x2="481" y2="300"
                                  transform="rotate(9 300 300)"/>

                        </g>

                        <g stroke-width="3.5">

                            <line x1="470" y1="300" x2="482" y2="300"
                                  transform="rotate(-4.5 300 300)"/>

                            <line x1="470" y1="300" x2="482" y2="300"
                                  transform="rotate(4.5 300 300)"/>

                        </g>

                    </g>

                    <!-- TICK CLUSTER 3 — rotated 240 degrees -->
                    <g transform="rotate(240 300 300)">

                        <g stroke-width="3.5">

                            <line x1="470" y1="300" x2="480" y2="300"
                                  transform="rotate(-13.5 300 300)"/>

                            <line x1="470" y1="300" x2="480" y2="300"
                                  transform="rotate(0 300 300)"/>

                            <line x1="470" y1="300" x2="480" y2="300"
                                  transform="rotate(13.5 300 300)"/>

                        </g>

                        <g stroke-width="3.8">

                            <line x1="469.5" y1="300" x2="481" y2="300"
                                  transform="rotate(-9 300 300)"/>

                            <line x1="469.5" y1="300" x2="481" y2="300"
                                  transform="rotate(9 300 300)"/>

                        </g>

                        <g stroke-width="3.5">

                            <line x1="470" y1="300" x2="482" y2="300"
                                  transform="rotate(-4.5 300 300)"/>

                            <line x1="470" y1="300" x2="482" y2="300"
                                  transform="rotate(4.5 300 300)"/>

                        </g>

                    </g>

                </g>

                <!-- SIXTH RING — COMPLETE DOTTED CIRCLE -->
                <!-- Only dots; no continuous solid stroke -->
                <!-- Dot spacing: 16 SVG units -->
                <circle
                    class="sixth-ring-dot-circle"
                    cx="300"
                    cy="300"
                    r="156"
                    fill="none"
                    stroke="#00dfff"
                    stroke-width="4"
                    stroke-dasharray="0.1 16"
                    stroke-linecap="round"
                />

            </svg>
        </div>

        <!-- ADDED — J.A.R.V.I.S. VECTOR LETTERING -->
        <div id="jarvis-wordmark">
            <svg
                id="jarvis-wordmark-svg"
                viewBox="0 0 600 600"
                xmlns="http://www.w3.org/2000/svg">

                <!-- Subtle cyan depth layer -->
                <g
                    fill="none"
                    stroke="#087f9d"
                    stroke-width="5.5"
                    stroke-linecap="square"
                    stroke-linejoin="round"
                    transform="translate(1.5 2)">

                    <!-- J -->
                    <path d="M 187 284 H 210 V 306
                             Q 210 320 198 320
                             Q 188 320 185 310"/>

                    <!-- A -->
                    <path d="M 224 320 L 237 285 L 250 320
                             M 229 307 H 245"/>

                    <!-- R -->
                    <path d="M 265 320 V 285 H 280
                             Q 293 285 293 296
                             Q 293 306 280 306 H 265
                             M 280 306 L 295 320"/>

                    <!-- V -->
                    <path d="M 312 285 L 326 320 L 340 285"/>

                    <!-- I -->
                    <path d="M 357 285 V 320"/>

                    <!-- S -->
                    <path d="M 405 289
                             Q 399 284 391 285
                             Q 379 285 379 294
                             Q 379 302 392 306
                             Q 405 309 405 314
                             Q 405 320 392 320
                             Q 383 320 378 315"/>

                </g>

                <!-- Main icy-cyan strokes -->
                <g
                    fill="none"
                    stroke="#c7f7ff"
                    stroke-width="4.5"
                    stroke-linecap="square"
                    stroke-linejoin="round">

                    <!-- J -->
                    <path d="M 187 282 H 210 V 304
                             Q 210 318 198 318
                             Q 188 318 185 308"/>

                    <!-- A -->
                    <path d="M 224 318 L 237 283 L 250 318
                             M 229 305 H 245"/>

                    <!-- R -->
                    <path d="M 265 318 V 283 H 280
                             Q 293 283 293 294
                             Q 293 304 280 304 H 265
                             M 280 304 L 295 318"/>

                    <!-- V -->
                    <path d="M 312 283 L 326 318 L 340 283"/>

                    <!-- I -->
                    <path d="M 357 283 V 318"/>

                    <!-- S -->
                    <path d="M 405 287
                             Q 399 282 391 283
                             Q 379 283 379 292
                             Q 379 300 392 304
                             Q 405 307 405 312
                             Q 405 318 392 318
                             Q 383 318 378 313"/>

                </g>

                <!-- Letter separators: J.A.R.V.I.S. -->
                <g fill="#c7f7ff">
                    <circle cx="217" cy="318" r="2.5"/>
                    <circle cx="258" cy="318" r="2.5"/>
                    <circle cx="303" cy="318" r="2.5"/>
                    <circle cx="348" cy="318" r="2.5"/>
                    <circle cx="366" cy="318" r="2.5"/>
                    <circle cx="414" cy="318" r="2.5"/>
                </g>

            </svg>
        </div>

    </div>
</body>
</rml>
