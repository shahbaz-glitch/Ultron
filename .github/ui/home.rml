<rml>
<head>
    <title>J.A.R.V.I.S. First Outer Ring</title>

    <style>
        /*
         * Transparent document.
         * Center the ring inside the RmlUi context.
         */
        rml,
        body {
            width: 100%;
            height: 100%;
            margin: 0px;
        }

        body {
            display: flex;
            justify-content: center;
            align-items: center;
            overflow: hidden;
        }

        /*
         * Ring uses 88% of the shorter viewport dimension.
         * No maximum-size cap.
         */
        #hud-container {
            position: relative;
            width: 88vw;
            height: 88vw;
            flex-shrink: 0;
            display: flex;
            justify-content: center;
            align-items: center;
            overflow: visible;
        }

        @media (orientation: landscape) {
            #hud-container {
                width: 88vh;
                height: 88vh;
            }
        }

        /*
         * Soft cyan-blue glow around the ring.
         * Keep the original ring geometry unchanged.
         */
        #jarvis-ring {
            width: 100%;
            height: 100%;
            filter:
                drop-shadow(
                    rgba(0, 191, 255, 191)
                    0px 0px 3.2px
                )
                drop-shadow(
                    rgba(0, 166, 255, 115)
                    0px 0px 7px
                );
        }
    </style>
</head>

<body>
    <div id="hud-container">
        <svg
            id="jarvis-ring"
            viewBox="0 0 600 600"
            xmlns="http://www.w3.org/2000/svg">

            <g class="outer-ring-group">

                <!-- Original outer cyan glow layer -->
                <circle
                    cx="300"
                    cy="300"
                    r="270"
                    fill="none"
                    stroke="#00d2ff"
                    stroke-width="14"
                />

                <!-- Cyan rim -->
                <circle
                    cx="300"
                    cy="300"
                    r="270"
                    fill="none"
                    stroke="#6be6ff"
                    stroke-width="16"
                />

                <!-- Sharp white ring -->
                <circle
                    cx="300"
                    cy="300"
                    r="270"
                    fill="none"
                    stroke="#ffffff"
                    stroke-width="16"
                />

            </g>
        </svg>
    </div>
</body>
</rml>
