
<rml>
<head>
    <title>Circle Ring Test</title>

    <style>
        body {
            width: 100%;
            height: 100%;
            margin: 0;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .circle-ring {
            width: 100px;
            height: 100px;
            border-width: 6px;
            border-color: #38bdf8;
            border-radius: 56px;
        }
    </style>
</head>

<body>
    <div class="circle-ring"></div>
</body>
</rml>
