
<rml>
<head>
    <title>Square Ring</title>

    <style>
        body {
            width: 100%;
            height: 100%;
            margin: 0;

            display: flex;
            align-items: center;
            justify-content: center;
        }

        .layout {
            display: flex;
            flex-direction: column;
            align-items: center;
        }

        .square-ring {
            width: 120px;
            height: 120px;

            border-width: 8px;
            border-color: #ff7ac8;
            border-radius: 22px;
        }

        button {
            margin-top: 24px;
            padding: 10px 18px;
            color: #ffffff;
            background-color: #343a46;
            border-width: 1px;
            border-color: #707987;
            border-radius: 8px;
        }
    </style>
</head>

<body>
    <div class="layout">
        <div class="square-ring"></div>

        <button data-action="toggle_ring">
            Switch Shape
        </button>
    </div>
</body>
</rml>
