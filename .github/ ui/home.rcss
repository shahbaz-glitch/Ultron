body {
    margin: 0px;
    width: 100%;
    height: 100%;
    background-color: #000000;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
}

#dot {
    width: 70px;
    height: 70px;
    margin-bottom: 24px;
    border-radius: 50%;
    background-color: #ff3030;
}

#dot.green {
    background-color: #22cc66;
}

button {
    width: 200px;
    height: 55px;
    font-size: 20px;
    color: #ffffff;
    background-color: #333333;
    border-radius: 10px;
}
